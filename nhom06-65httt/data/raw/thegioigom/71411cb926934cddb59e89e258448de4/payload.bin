: null, "product_url": "https://thegioigom.com/san-pham/mau-binh-chua-nung-2/", "category": "Phôi Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TGG-8924", "name": "Mẫu ly gốm chưa nung", "description": null, "product_url": "https://thegioigom.com/san-pham/mau-ly-gom-chua-nung/", "category": "Phôi Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TGG-8920", "name": "Mẫu bình chưa nung", "description": null, "product_url": "https://thegioigom.com/san-pham/mau-binh-chua-nung/", "category": "Phôi Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TGG-8912", "name": "Chén hoa gốm", "description": null, "product_url": "https://thegioigom.com/san-pham/chen-hoa-gom/", "category": "Sản Phẩm Từ Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672393035", "name": "Men Trong Nhúng Nhiệt Thấp Amaco DC-10 Gal Clear, Gallon 3,78 lít", "description": "*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]\" dir=\"auto\" data-turn-id=\"request-WEB:4fe3e827-febc-43d0-abb6-5a5ddc46ec68-73\" data-turn-id-container=\"request-WEB:4fe3e827-febc-43d0-abb6-5a5ddc46ec68-73\" data-testid=\"conversation-turn-36\" data-scroll-anchor=\"false\" data-turn=\"assistant\"> AMACO DC-10 Low Fire Dipping Clear Liquid là men nhúng trong suốt nhiệt thấp, chuyên dùng cho kỹ thuật nhúng men (dipping glaze) ở Cone 05. Công thức men được thiết kế giúp lớp men phủ đều, bám nhanh và gần như ngừng chảy ngay khi nhấc sản phẩm ra khỏi xô men, rất phù hợp cho studio gốm, lớp học và sản xuất số lượng lớn. Đặc điểm nổi bật Men trong suốt nhiệt thấp chuyên dùng để nhúng Bề mặt bóng đẹp, trong và sạch Độ phủ đồng đều, dễ kiểm soát độ dày men Khô nhanh sau khi nhúng Giúp tiết kiệm thời gian thao tác Không chì (Lead Free) Đạt chuẩn an toàn ASTM D-4236 Thông số nung Nhiệt độ nung hoàn thiện: Cone 05 (~1030°C) Khuyến nghị dùng trên sản phẩm đã nung biscuit Cone 04 Dòng men: Low Fire Dipping Glaze Ứng dụng Phủ men trong cho underglaze Dùng cho lớp học vẽ gốm & PYOP Studio Phù hợp sản xuất hàng loạt nhờ tốc độ thao tác nhanh Có thể dùng bằng: Nhúng men Rót men Phun men (với thiết bị phù hợp) Hướng dẫn sử dụng Khuấy đều men trước khi dùng Nhúng sản phẩm biscuit vào men trong thời gian ngắn Để men ráo và khô tự nhiên Lau sạch chân sản phẩm Nung hoàn thiện ở Cone 05 Ưu điểm khi sử dụng DC-10 Giảm vệt cọ so với men quét Tạo lớp men trong đẹp và ổn định Giúp màu underglaze nổi bật hơn Dễ thao tác với người mới học gốm Phù hợp cho các studio trải nghiệm làm gốm Lưu ý Chỉ phủ men trên sản phẩm đã biscuit Không để lớp men quá dày để tránh chảy men Người sản xuất đồ dùng ăn uống cần kiểm tra sản phẩm sau nung để đảm bảo tiêu chuẩn dinnerware safe tùy theo điều kiện nung thực tế. Nguồn tham khảo: DC-10 Low-Fire Dipping Clear (Liquid) .", "product_url": "https://thegioigom.com/san-pham/men-trong-nhung-nhiet-thap-amaco-dc-10-gal-clear-gallon-378-lit/", "category": "Men Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 2272000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672413825", "name": "Sáp Chống Dính Men Amaco Wax Resist, Pint 472ml", "description": "AMACO Wax Resist là sáp chống dính men dạng lỏng, dùng để ngăn men, slip hoặc underglaze bám vào những vùng không mong muốn trên sản phẩm gốm. Sản phẩm có thể sử dụng trên đất da (leather hard), gốm mộc (greenware) hoặc gốm đã nung sơ (bisque). Đặc điểm nổi bật Giúp tạo họa tiết, đường nét và vùng chống men chính xác Dễ sử dụng bằng cọ, mút hoặc nhúng Có màu nhẹ giúp dễ nhìn thấy vùng đã quét khi thao tác Màu sẽ cháy hết sau khi nung Không độc hại (AP Certified Non-Toxic) Phù hợp cho studio, lớp học và sản xuất gốm thủ công Công dụng Chống dính men ở chân sản phẩm Tạo hoa văn decorative bằng kỹ thuật wax resist Ngăn men chảy vào khu vực không mong muốn Hỗ trợ layering glaze và underglaze hiệu quả hơn Hướng dẫn sử dụng Khuấy đều trước khi dùng Dùng cọ hoặc mút quét lên vùng cần chống men Đợi lớp wax khô hoàn toàn Tiếp tục phủ men hoặc underglaze lên sản phẩm Sau khi nung, lớp wax sẽ cháy hết và để lại vùng sạch men Thông tin sản phẩm Dạng: Wax emulsion (sáp nước) Quy cách: Pint 473ml Tiêu chuẩn an toàn: ASTM D-4236 Thương hiệu: AMACO – USA Lưu ý Lưu ý khi trang trí trên lớp men: theo AMACO, wax resist có thể làm bong lớp men nhúng hoặc lớp men không được bổ sung gum. Không phủ men lên vùng đã quét wax resist Đậy kín sau khi sử dụng để tránh khô Nên vệ sinh cọ ngay sau khi dùng Người sản xuất đồ dùng ăn uống cần kiểm tra sản phẩm sau nung để đảm bảo tiêu chuẩn dinnerware safe Nguồn tham khảo: Wax Resist .", "product_url": "https://thegioigom.com/san-pham/sap-chong-dinh-men-amaco-wax-resist-pint-473ml/", "category": "Phụ Gia Ngành Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 1189000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672413719", "name": "Dung Dịch Tăng Độ Bám Và Giúp Ổn Định Men Gốm Amaco Gum Solution, Pint 472ml", "description": "AMACO Gum Solution là phụ gia chuyên dụng giúp tăng độ kết dính và độ bám của men gốm lên bề mặt xương gốm. Sản phẩm hỗ trợ giảm hiện tượng bong tróc, bụi men hoặc nứt lớp men khô trước khi nung, đặc biệt hữu ích với các loại men tự pha, underglaze hoặc kỹ thuật phủ nhiều lớp men. Gum Solution giúp lớp men sau khi khô có độ cứng và độ ổn định tốt hơn, hạn chế việc men bị trầy xước hoặc rơi bột khi cầm nắm và vận chuyển sản phẩm trước khi nung. Ngoài ra, sản phẩm còn hỗ trợ cải thiện khả năng quét men, giúp men trải đều và mịn hơn trên bề mặt gốm. Ứng Dụng: Tăng độ bám của men lên xương gốm Giảm bong tróc và bụi men sau khi khô Hỗ trợ men tự pha và underglaze ổn định hơn Phù hợp cho kỹ thuật phủ nhiều lớp men Cải thiện độ mịn và khả năng quét men Hướng Dẫn Sử Dụng: Thêm từng lượng nhỏ Gum Solution vào men và khuấy đều Điều chỉnh lượng sử dụng tùy theo độ đặc và nhu cầu của men Có thể dùng với men quét, men nhúng hoặc underglaze Lưu Ý: Không nên sử dụng quá nhiều vì có thể làm men khô chậm Khuấy đều trước khi dùng Đậy kín sau khi sử dụng để tránh bay hơi Dung Tích: Pint 473ml Nguồn tham khảo: Gum Solution .", "product_url": "https://thegioigom.com/san-pham/dung-dich-tang-do-bam-va-giup-on-dinh-men-gom-amaco-gum-solution-pint-473ml/", "category": "Phụ Gia Ngành Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 503000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672413238", "name": "Chất Ổn Định Men Gốm Amaco SuspendAid, Pint 472ml", "description": "AMACO SuspendAid là phụ gia chuyên dụng giúp chuyển men quét (brushing glaze) sang dạng phù hợp để nhúng hoặc rót men dễ dàng hơn. Chỉ cần thêm nước cất và SuspendAid, men sẽ có độ ổn định tốt hơn cho các kỹ thuật dipping và pouring. Sản phẩm được thiết kế để hạn chế hiện tượng lắng cứng của men, đặc biệt với các loại men đã được pha thêm nước. Khi men bị pha loãng để tạo màu nhẹ hơn hoặc phục vụ phương pháp phủ men khác ngoài quét cọ, hiện tượng tách nước và đóng cặn thường xảy ra. SuspendAid giúp giữ các hạt men phân tán đều, giảm lắng đáy và giúp men dễ khuấy lại hơn. Ứng Dụng: Chuyển men quét thành men nhúng hoặc men rót Giảm hiện tượng lắng cứng của men Hỗ trợ ổn định men khi pha thêm nước Giúp lớp men phủ đều và dễ sử dụng hơn Phù hợp cho studio gốm, workshop và nghệ nhân gốm Hướng Dẫn Pha Tham Khảo: Cho 473ml men: Đổ khoảng 355ml men vào thùng chứa Thêm 118ml nước cất Thêm 15ml SuspendAid Khuấy đều trước khi sử dụng Cho 3,78 lít men: Đổ khoảng 2,8 lít men vào thùng chứa Thêm 710ml nước cất Thêm khoảng 177ml SuspendAid Khuấy đều trước khi sử dụng Dung Tích: Pint 473ml Nguồn tham khảo: Suspendaid .", "product_url": "https://thegioigom.com/san-pham/chat-on-dinh-men-gom-amaco-suspendaid/", "category": "Phụ Gia Ngành Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 686000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672413917", "name": "Cao Su Lỏng Làm Khuôn Amaco Latex Rubber, Pint 472ml", "description": "AMACO Rubber Latex là cao su lỏng chuyên dùng để tạo khuôn đổ thạch cao, khuôn trang trí và nhiều ứng dụng thủ công mỹ thuật. Sản phẩm có dạng latex lỏng màu trắng, được quét trực tiếp lên mẫu gốc để tạo lớp khuôn mềm dẻo, bền và có thể sử dụng nhiều lần. Đặc điểm nổi bật Latex lỏng màu trắng, dễ quét nhiều lớp Khuôn sau khi hoàn thiện có độ dẻo và đàn hồi cao Có thể chịu được khoảng 200–300 lần đổ khuôn Phù hợp để đổ: Thạch cao (Plaster of Paris) AMACO Setstone Dùng tốt cho: Làm khuôn gốm Tạo texture Phục chế chi tiết trang trí DIY & thủ công mỹ nghệ Hướng dẫn sử dụng Làm sạch và chuẩn bị mẫu gốc Dùng cọ quét từng lớp Rubber Latex lên bề mặt mẫu Đợi khô giữa các lớp trước khi quét tiếp Sau khi đạt độ dày mong muốn, bóc khuôn ra khỏi mẫu Tiến hành đổ thạch cao hoặc vật liệu casting vào khuôn Ứng dụng trong gốm Ngoài làm khuôn, Rubber Latex còn có thể dùng như chất chống men (resist) để tạo hoa văn trên bề mặt gốm. Tuy nhiên lớp latex cần được loại bỏ hoàn toàn trước khi nung men. Thông tin sản phẩm Quy cách phổ biến: Pint 472ml Thương hiệu: AMACO – USA Tiêu chuẩn an toàn: ASTM D-4236/LHAMA Không dùng cho trẻ em K–6 theo khuyến nghị của nhà sản xuất Lưu ý Không để sản phẩm bị đông lạnh Đậy kín nắp sau khi sử dụng Làm việc ở nơi thông thoáng Vệ sinh cọ ngay sau khi dùng để tránh latex khô cứng Nguồn tham khảo: Rubber Latex .", "product_url": "https://thegioigom.com/san-pham/cao-su-long-lam-khuon-amaco-latex-rubber-pint-473ml/", "category": "Phụ Gia Ngành Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 1783000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "039672288973", "name": "Keo Sửa Gốm Non Amaco Bisque Fix 4 Oz, 118 ml", "description": "Keo Sửa Gốm Non AMACO Bisque Fix là vật liệu chuyên dụng giúp sửa chữa các sản phẩm gốm sau nung sơ (bisque). Sản phẩm có dạng hồ trắng, dùng để gắn các chi tiết bị vỡ, trám các lỗ hổng hoặc vá các vết mẻ trên bề mặt gốm trước khi phủ men và nung hoàn thiện. Bisque Fix có thể pha thêm oxide kim loại hoặc ceramic stain để điều chỉnh màu sắc gần giống với màu xương gốm, giúp vùng sửa chữa tự nhiên hơn sau khi nung. Sau khi sử dụng, sản phẩm có thể được nung đến Cone 10 (1305°C). Ứng Dụng: Gắn lại tay cầm, chi tiết gốm bị vỡ sau nung sơ Trám lỗ, mẻ hoặc các vùng khuyết trên xương gốm Sửa lỗi sản phẩm trước khi phủ men Phù hợp cho studio gốm, nghệ nhân và trường học Hướng Dẫn Sử Dụng: Làm sạch khu vực cần sửa Dùng bay hoặc dao nhỏ để trét Bisque Fix lên vị trí cần vá/gắn Để khô hoàn toàn Chà nhám nhẹ nếu cần Phủ men và nung ở nhiệt độ phù hợp với xương gốm Lưu Ý Bảo Quản: Bisque Fix là vật liệu khô cứng theo không khí. Sau khi sử dụng nên thêm một lớp nước mỏng lên bề mặt sản phẩm trước khi đóng nắp để kéo dài thời gian sử dụng. Khi dùng lại, đổ lớp nước đi, khuấy đều và sử dụng như bình thường. Dung Tích: 4 fl oz (118ml) Nguồn tham khảo: Bisque Fix .", "product_url": "https://thegioigom.com/san-pham/keo-sua-gom-non-amaco-bisque-fix-4-oz-118-ml/", "category": "Phụ Gia Ngành Gốm", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 1554000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TMBGO-008-TB-0021", "name": "Lò Nung Gốm Bằng Điện – Mẫu JD2945-3 – L&L Kilns", "description": "Lò điện tự động Jupiter Model JD2945-3 là mẫu lò nung điện ba vùng điều khiển có dung tích lớn nhất trong dòng DaVinci Series của Hotkilns – một lựa chọn hàng đầu cho các xưởng gốm công nghiệp, trung tâm đào tạo chuyên sâu và nghệ nhân chuyên nghiệp có nhu cầu nung sản phẩm khổ lớn, cao và nặng. Với thiết kế hộp chữ nhật đứng đặc trưng của dòng DaVinci, JD2945-3 sở hữu buồng nung siêu sâu và dung tích rất lớn , lý tưởng để xử lý các sản phẩm cao như tượng lớn, bình khổ lớn, hay xếp nhiều tầng sản phẩm trong một lần nung. Cấu trúc vuông chắc chắn giúp tận dụng tối đa không gian buồng nung và đảm bảo phân bố nhiệt đồng đều. Lò được trang bị hệ thống ba vùng điều khiển độc lập , giúp người vận hành kiểm soát chính xác nhiệt độ theo chiều cao – cực kỳ cần thiết khi nung sản phẩm dày, cao hoặc có hình khối không đồng đều. Bộ bảng điều khiển Genesis cảm ứng được lắp trong bảng điện rời dạng Plug-in Panel , cho phép thao tác nhanh, bảo trì dễ dàng và nâng cấp thuận tiện. Bảng thông số kỹ thuật Thông Số Giá Trị Vật liệu cách nhiệt Gạch chịu lửa K23 dày ≈ 7.6 cm Nguồn điện 220V Số phân đoạn 5 đoạn cao 22.8 cm Kích thước trong ≈ Đường kính 71.1 cm x Cao 114.3 cm Kích thước ngoài ≈ Rộng 91.4 cm x Sâu 124.4 cm x Cao 233.6 cm Trọng lượng ≈ 268 (kg) Tính Năng Phụ Kiện Khác", "product_url": "https://thegioigom.com/san-pham/lo-nung-gom-bang-dien-mau-jd2945-3-ll-kilns/", "category": "Lò Nung Bằng Điện", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 446703000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TMBGO-008-TB-0020", "name": "Lò Nung Gốm Bằng Điện – Mẫu JD2936-3 – L&L Kilns", "description": "Lò nung tự động Jupiter Model JD2936-3 là mẫu lò nung điện ba vùng điều khiển, thuộc dòng DaVinci Series – dòng lò khối vuông công nghiệp cao cấp nhất của Hotkilns , được thiết kế chuyên biệt cho các xưởng sản xuất gốm quy mô lớn, cơ sở đào tạo nghề, và các nghệ nhân cần xử lý các mẻ nung khối lượng lớn, sản phẩm cao hoặc phức tạp về hình khối. Với buồng nung hình hộp đứng, siêu sâu , JD2936-3 là một trong những mẫu lò có chiều cao buồng nung lớn nhất trong dòng DaVinci – lý tưởng để nung tượng, bình cao, sản phẩm nhiều tầng hoặc các mẻ nung khổ lớn. Thiết kế vuông vức tối ưu không gian nội thất, tăng hiệu quả sắp xếp và nung từng mẻ. Lò được trang bị ba vùng điều khiển nhiệt độ độc lập theo chiều cao buồng nung, giúp phân bổ nhiệt đồng đều từ dưới lên trên – điều đặc biệt quan trọng khi nung sản phẩm cao, dày hoặc có độ nhạy nhiệt khác nhau. Bộ bảng điều khiển Genesis cảm ứng , đi kèm bảng điện rời dạng “Plug-in Panel” – một thiết kế độc quyền của dòng Jupiter và DaVinci, cho phép tháo rời dễ dàng để bảo trì, nâng cấp hoặc thay thế linh kiện mà không làm gián đoạn hệ thống chính. Bảng thông số kỹ thuật Thông Số Giá Trị Vật liệu cách nhiệt Gạch chịu lửa K23 dày ≈ 7.6 cm Nguồn điện 220V Số phân đoạn 4 đoạn cao 22.8 cm Kích thước trong ≈ Đường kính 71.1 cm x Cao 91.4 cm Kích thước ngoài ≈ Rộng 91.4 cm x Sâu 124.4 cm x Cao 210.8 cm Trọng lượng ≈ 234 (kg) Tính Năng Phụ Kiện Khác", "product_url": "https://thegioigom.com/san-pham/lo-nung-gom-bang-dien-mau-jd2936-3-ll-kilns/", "category": "Lò Nung Bằng Điện", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 377366000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TMBGO-008-TB-0019", "name": "Lò Nung Gốm Bằng Điện – Mẫu JD2927-3 – L&L Kilns", "description": "Lò nung tự động Jupiter Model JD2927-3 là mẫu lò nung điện ba vùng điều khiển, thuộc dòng Jupiter Series – dòng lò công nghiệp dạng khối đứng cao cấp của Hotkilns , được thiết kế dành cho các xưởng gốm lớn, trung tâm đào tạo chuyên sâu và nghệ nhân chuyên nghiệp cần xử lý các mẻ nung lớn, sản phẩm cao hoặc có hình khối phức tạp. Lò có thiết kế hộp chữ nhật đứng , buồng nung rộng và sâu , mang lại dung tích lớn, lý tưởng để nung các sản phẩm gốm cỡ lớn như tượng, bình cao, tác phẩm điêu khắc hoặc nhiều tầng gốm cùng lúc. Không gian buồng nung được tận dụng tối đa nhờ thiết kế dạng khối, nâng cao hiệu suất trong từng mẻ nung. JD2927-3 được trang bị ba vùng điều khiển nhiệt độ độc lập , giúp nhiệt phân bố đều từ đáy lên đỉnh lò, hạn chế tối đa chênh lệch nhiệt độ – điều đặc biệt quan trọng khi nung các sản phẩm có chiều cao lớn hoặc cấu trúc không đồng đều. Hệ thống điều khiển sử dụng bảng cảm ứng Genesis tích hợp trên bảng điều khiển rời dạng “Plug-in Panel” – đặc trưng riêng của dòng Jupiter, giúp bảo trì, thay thế hoặc nâng cấp linh kiện một cách dễ dàng. Bảng thông số kỹ thuật Thông Số Giá Trị Vật liệu cách nhiệt Gạch chịu lửa K23 dày ≈ 7.6 cm Nguồn điện 220V Số phân đoạn 3 đoạn cao 22.8 cm Kích thước trong ≈ Đường kính 71.1 cm x Cao 68.5 cm Kích thước ngoài ≈ Rộng 91.4 cm x Sâu 124.4 cm x Cao 187.9 cm Trọng lượng ≈ 197 (kg) Tính Năng Phụ Kiện Khác", "product_url": "https://thegioigom.com/san-pham/lo-nung-gom-bang-dien-mau-jd2927-3-ll-kilns/", "category": "Lò Nung Bằng Điện", "material": "Gốm sứ", "origin_region": "Việt Nam", "price_vnd": 269155000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "TMBGO-008-TB-0018", "name": "Lò Nung Gốm Bằng Điện – Mẫu JD230-3-EZ – L&L Kilns", "description": "Lò nung tự động Model JD230-3-EZ Jupiter với bộ điều khiển DynaTrol được lắp ở bảng điều khiển riêng, cho phép điều khiển riêng rẽ tốc độ tăng nhiệt ở ba vị trí khác nhau trong lò. Lò có nắp dạng nhấc đốt mắt đỡ có khoảng không khí giữa các nút điều khiển và lò nung. Kết cấu theo tường phẳng và theo mô-đun cho phép mở rộng trong tương lai. Lò đi kèm với giá đỡ các thanh gốm cứng, cặp nhiệt điện được bảo vệ, chân đế chắc chắn và nút lò nhìn chắc chắn. Lò được cách nhiệt bằng Gạch K23 3″. Sử dụng các thanh Easy-Fire e23T để có công suất cao hơn (48 ampe). Dây nguồn NEMA 6-50 một pha. Lò nung có chân đế di động (Rolling Stand) cho