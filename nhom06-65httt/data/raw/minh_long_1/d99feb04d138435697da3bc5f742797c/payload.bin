/minhlong.com/products/day-deo-mat-day-hien-chau-long-khanh", "category": "Nữ Trang", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1057320, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_041418014", "name": "Dĩa lót tách 14 cm - Jasmine - Chỉ Vàng", "description": null, "product_url": "https://minhlong.com/products/dlot-tach-14-cm-jasmine-chi-vang", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 65880, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_591166498", "name": "Chén cơm 11.5 cm - Timeless - Vườn Nhà", "description": "Lấy ý tưởng từ những hình ảnh của vườn quê thân thuộc, Vườn nhà tái hiện sống động bức tranh khung cảnh khu vườn quê vào mùa đơm hoa, kết trái với vẻ đẹp thân thuộc, mộc mạc và thanh bình. Vườn Nhà tạo điểm nhấn với hình ảnh những quả bí ngô to tròn, những bông hoa đang bung nở được phác họa một cách chân thực, tinh tế.", "product_url": "https://minhlong.com/products/chen-com-11-5-cm-timeless-vuon-nha", "category": "Timeless", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 56160, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_041218014", "name": "Dĩa lót tách 12 cm - Jasmine - Chỉ Vàng", "description": null, "product_url": "https://minhlong.com/products/dlot-tach-12-cm-vcv-jas", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 45360, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_214888VHNH", "name": "Ly sứ dưỡng sinh 0.48 L (K1) + nắp ống hút - Dưỡng Sinh - Nam Quốc - Hà Nội", "description": "Với Ly sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Các nét vẽ sáng tạo, trẻ trung và phóng khoáng, lưu giữ trọn vẹn câu chuyện tinh hoa văn hóa Việt theo ngôn ngữ riêng của sứ. Nơi vẻ đẹp quê hương hòa vào nhịp sống hiện đại, vừa quen thuộc vừa mới mẻ. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và thấy mình trở thành một phần của hành trình ấy. Một hành trình đầy tự hào, hòa mình vào bản sắc văn hóa Việt theo cách riêng, chân thành và đầy cảm xúc. Chế tác kế thừa những công năng đặc biệt về sức khoẻ từ dòng sứ dưỡng sinh, nhờ khả năng phát ra ion âm tự nhiên. Những ion âm này giúp bảo vệ và nâng cao sức khoẻ người sử dụng, đồng thời tối ưu hoá việc bảo quản thức uống.", "product_url": "https://minhlong.com/products/ly-su-duong-sinh-0-48-l-k1-nap-ong-hut-duong-sinh-nqhanoi", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 352080, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_214889000N", "name": "Ly sứ dưỡng sinh 0.48 L (K2) + Nắp - Dưỡng sinh - Trắng", "description": null, "product_url": "https://minhlong.com/products/ly-su-duong-sinh-minh-long-0-48-l-nap-thuong-trang-k2", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 195480, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23140401458V", "name": "[GT] Muỗng - Jasmine - Mùa Xuân (Vàng)", "description": null, "product_url": "https://minhlong.com/products/muong-jasmine-mua-xuan", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 40068, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23STL10", "name": "[GT] Sắc tộc 5cm (bộ 10-5 hình) - Minh Long - Lưu Niệm", "description": null, "product_url": "https://minhlong.com/products/sac-toc-5cm-bo-10-5-hinh", "category": "Lưu niệm", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 52272, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_041218385", "name": "Dĩa lót tách - Jasmine - Chim Lạc", "description": "Chim Lạc là một trong những linh vật truyền thống từ thời dựng nước, một thời là biểu tượng của đất nước Âu Lạc. Chim Lạc cũng là biểu tượng của phồn thịnh, bình an và may mắn. Khéo léo kết hợp giá trị văn hoá vào sản phẩm sứ, Minh Long I đã cho ra đời bộ sản phẩm Jasmine Chim Lạc với từng đường nét hoa văn mang đậm nét truyền thống, cổ điển, nhưng vừa sang trọng vừa nhã nhặn, tinh tế và hiện đại.", "product_url": "https://minhlong.com/products/dia-lot-tach-jasmine-chim-lac-3", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 38880, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_691031VTN", "name": "Chai sứ dưỡng sinh vuông 1.0 L + nắp (K1) - Dưỡng Sinh - Nam Quốc - Tây Nguyên", "description": "Với Bộ sưu tập Chai sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và tự hào. Chai sứ Nam Quốc - Tây Nguyên như một khúc ca ngân vang giữa đại ngàn hùng vĩ, cùng những câu chuyện truyền đời được kể qua các hoa văn nghệ thuật trên sứ cao cấp. Minh Long đã khéo léo kết hợp các địa danh nổi tiếng trên một tác phẩm, nơi tinh hoa thiên nhiên và bản sắc văn hóa đặc trưng của các dân tộc anh em hòa quyện, tạo nên một không gian đầy lôi cuốn và kỳ bí. Từ mái nhà Rông vút cao biểu tượng của núi rừng, thác nước Đamb’ri tung bọt trắng xóa như dải lụa mềm, đến nhịp cồng chiêng vang vọng, lễ hội rộn ràng và bóng dáng những bản làng yên bình ẩn mình trong sương sớm. Tây Nguyên không chỉ là một món quà nghệ thuật mà là một phần của lịch sử, văn hóa và thiên nhiên sống động nơi đây.", "product_url": "https://minhlong.com/products/chai-su-duong-sinh-vuong-1-0-l-nap-k1-duong-sinh-nam-quoc-tay-nguyen", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1026000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_691031VNT", "name": "Chai sứ dưỡng sinh vuông 1.0 L + nắp (K1) - Dưỡng Sinh - Nam Quốc - Nam Trung Bộ", "description": "Với Bộ sưu tập Chai sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và tự hào. Chai sứ Nam Quốc - Nam Trung Bộ khắc họa vẻ đẹp đặc trưng của vùng đất duyên hải, trải dài từ Đà Nẵng đến Bình Thuận. Mỗi chi tiết nổi bật trên nền sứ cao cấp, tạo nên một bức tranh hài hòa, phản ánh sự kết nối giữa thiên nhiên tươi đẹp và nền văn hóa đa dạng, giàu bản sắc. Người thưởng lãm như được đi qua và “chạm” vào những di tích lịch sử và thắng cảnh nổi bật nơi đây. Chai sứ hoa văn Nam Trung Bộ không chỉ là một món quà nghệ thuật, mà còn là sự giao thoa giữa quá khứ và hiện tại, giữa những di sản văn hóa truyền thống cùng khát vọng vươn lên của miền Trung đầy nắng gió này.", "product_url": "https://minhlong.com/products/chai-su-duong-sinh-vuong-1-0-l-nap-k1-duong-sinh-nam-quoc-nam-trung-bo", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1026000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_691031VDN", "name": "Chai sứ dưỡng sinh vuông 1.0 L + nắp (K1) - Dưỡng Sinh - Nam Quốc - Đồng Bằng Nam Bộ", "description": "Với Bộ sưu tập Chai sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và tự hào. Chai sứ Nam Quốc - Đồng Bằng Nam Bộ là bức họa thu nhỏ tinh tế và tràn đầy sức sống về miền đất phương Nam trù phú. Các địa danh và biểu tượng nổi tiếng được tái hiện hoàn hảo trên nền sứ sáng bóng, tạo nên nhịp điệu uyển chuyển và thơ mộng. Đặc biệt, hình ảnh tòa nhà Minh Long (Bình Dương) vươn cao, uy nghiêm, hòa quyện vào không gian xung quanh, thể hiện sự phát triển mạnh mẽ của “thủ phủ công nghiệp miền Nam”. Các tác phẩm sứ nổi bật do Minh Long chế tác như: Nồi Sứ Dưỡng Sinh, Cúp APEC,… cũng được kết hợp đầy ý tứ, như một dấu ấn tự hào, góp phần gìn giữ và phát huy giá trị của làng nghề gốm sứ truyền thống Việt Nam. Những đường nét thanh thoát kết hợp với kỹ thuật vẽ màu chìm dưới men, giúp Chai sứ toát lên vẻ đẹp hoàn mỹ, để người thưởng lãm như được du ngoạn khắp vùng đất Nam Bộ giàu bản sắc và nghĩa tình.", "product_url": "https://minhlong.com/products/chai-su-duong-sinh-vuong-1-0-l-nap-k1-duong-sinh-nam-quoc-dong-bang-nam-bo", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1026000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_691031VBT", "name": "Chai sứ dưỡng sinh vuông 1.0 L + nắp (K1) - Dưỡng Sinh - Nam Quốc - Bắc Trung Bộ", "description": "Với Bộ sưu tập Chai sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và tự hào. Chai sứ Nam Quốc - Bắc Trung Bộ gửi gắm niềm tự hào về một miền đất kiên cường, vượt qua bao thăng trầm, nhưng vẫn giữ vững được bản sắc và vẻ đẹp riêng biệt. Mỗi họa tiết là một câu chuyện đầy cảm hứng về đất và người Bắc Trung Bộ: từ Quảng Bình Quan hùng vĩ, Lăng Tự Đức uy nghiêm, đến Chùa Thiên Mụ linh thiêng hay vịnh biển Lăng Cô yên bình,… nơi tinh thần vượt khó luôn song hành cùng sự thanh tao, sâu lắng. Với những ai yêu mến mảnh đất Bắc Trung Bộ không chỉ là món quà giao hảo, mà còn là một phần của di sản, lưu giữ và tôn vinh vẻ đẹp vĩnh cửu của vùng đất giàu truyền thống và lịch sử.", "product_url": "https://minhlong.com/products/chai-su-duong-sinh-vuong-1-0-l-nap-k1-duong-sinh-nam-quoc-bac-trung-bo", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1026000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_691031VDB", "name": "Chai sứ dưỡng sinh vuông 1.0 L + nắp (K1) - Dưỡng Sinh - Nam Quốc - Đồng Bằng Bắc Bộ", "description": "Với Bộ sưu tập Chai sứ Nam Quốc, các danh lam thắng cảnh đặc sắc trên dải đất Việt hiện lên sống động như những tuyệt tác nghệ thuật đương đại. Đó là chuyến du ngoạn thu nhỏ, giúp người thưởng lãm chiêm ngưỡng vẻ đẹp muôn màu của một Việt Nam đầy yêu thương và tự hào. Chai sứ Nam Quốc - Đồng Bằng Bắc Bộ như lời tự tình về vùng đất châu thổ trù phú, nơi lưu giữ các giá trị văn hóa lâu đời và nghệ thuật dân gian đặc sắc. Những hình ảnh tiêu biểu như: Tam Cốc Bích Động với những dãy núi đá vôi sừng sững, Hội Lim hòa mình trong các làn điệu quan họ ngân vang, những ngôi chùa cổ kính tĩnh lặng,… đều hiện lên sống động trong từng chi tiết, phản ánh vẻ đẹp giản dị nhưng sâu sắc của miền đồng bằng, nơi cội nguồn văn hóa được gìn giữ qua bao thế hệ. Chai sứ là biểu tượng cho sự bền vững của những giá trị truyền thống, kết nối con người với thiên nhiên, quá khứ với hiện tại. Minh Long đã tinh tế gửi gắm một phần hồn của đất Bắc, tôn vinh vẻ đẹp và văn hóa trường tồn theo thời gian, lan tỏa tinh hoa của đồng bằng Bắc Bộ đến muôn nơi.", "product_url": "https://minhlong.com/products/chai-su-duong-sinh-vuong-1-0-l-nap-k1-duong-sinh-nam-quoc-dong-bang-bac-bo", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1026000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_214890000N", "name": "Ly sứ dưỡng sinh 0.48 L (K3) + Nắp - Dưỡng Sinh - Trắng", "description": null, "product_url": "https://minhlong.com/products/ly-su-duong-sinh-0-48-l-k3-nap-thuong-trang", "category": "Dưỡng Sinh", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 183600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153502559T", "name": "Ca quai tròn 0.35 L - Misc Assortment - Tổ Quốc", "description": "Ca Tổ Quốc là kết tinh giữa niềm tự hào dân tộc và vẻ đẹp của sứ đương đại. Màu đỏ là một trong những gam màu khó thể hiện nhất trên gốm sứ. Nay được Minh Long chinh phục bằng kỹ thuật phối men đặc biệt và công nghệ nung một lần lửa theo tiêu chuẩn Châu Âu, mang đến vẻ đẹp vừa trang nhã vừa sang trọng. Ngôi sao vàng lấp lánh, biểu tượng của tự do và hòa bình, kết hợp cùng dòng chữ “Tôi yêu Tổ quốc tôi”, hòa quyện thành một bản hòa ca của lòng yêu nước. Là phiên bản đặc biệt được chế tác với tất cả tâm huyết, Ca Tổ Quốc gửi gắm trọn vẹn tình yêu thiêng liêng dành cho một Việt Nam thịnh vượng, trường tồn.", "product_url": "https://minhlong.com/products/ca-quai-tron-0-35-l-misc-assortment-to-quoc", "category": "Misc Assortment", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 237600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23472209000", "name": "[GT] Dĩa tròn 22 cm - Jasmine IFP - Trắng Ngà", "description": null, "product_url": "https://minhlong.com/products/dia-tron-22-cm-jasmine-ifp-trang-nga", "category": "Jasmine IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 57456, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23140401019", "name": "[GT] Muỗng - Jasmine - Quả Ngọt", "description": null, "product_url": "https://minhlong.com/products/muong-jasmine-qua-ngot", "category": "Khác", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 18792, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_441753522CV", "name": "Tượng Rắn Thanh Xà - Men Ngọc Sương Mờ (vàng) (N)", "description": "Tượng Thanh Xà không chỉ là hình tượng quyền uy mà còn mang ý nghĩa nhân văn sâu sắc. Đầu rắn kiêu hãnh vươn cao, đội chiếc mũ vua được khắc chữ “Vương” tinh tế, một biểu tượng của quyền lực tối thượng. Nhưng quyền lực ấy luôn được soi sáng bởi trách nhiệm và đạo đức. Điều đặc biệt nhất trong tạo hình của Tượng Thanh Xà chính là bảo vật ẩn dưới chân rắn. Đó chính là cái “Tâm” - giá trị cốt lõi của con người, quý hơn cả vàng bạc châu báu. Chữ “Tâm”, qua bàn tay tài hoa của các nghệ nhân Minh Long, không chỉ tỏa sáng trong nghệ thuật mà còn khơi dậy những suy ngẫm sâu sắc. Bởi lẽ, Cụ Nguyễn Du (một nhà thơ vĩ đại của dân tộc Việt Nam) từng viết: “Chữ Tâm kia mới bằng ba chữ Tài”. Tạo hình không khoe sự giàu sang vật chất, mà tôn vinh triết lý lãnh đạo từ tâm. Tượng Rắn Thanh Xà không chỉ biểu tượng cho niềm tin và may mắn, mà còn là hình ảnh của người lãnh đạo có tâm, tạo ra những lợi ích vì cộng đồng. Sở hữu tượng là nắm giữ các giá trị cao quý, khơi dậy sức mạnh nội tâm để vươn tới thành công. Như câu nói “Tâm chánh thì sự tất thành”, Rắn Thần giúp con người giữ vững hoài bão và hiện thực hóa những ước mơ.", "product_url": "https://minhlong.com/products/tuong-ran-thanh-xa-men-ngoc-suong-mo-vang-n", "category": "Tượng", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 5400000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_441753BMNV", "name": "Tượng Rắn Thanh Xà - Men ngọc (bóng)", "description": "Tượng Thanh Xà không chỉ là hình tượng quyền uy mà còn mang ý nghĩa nhân văn sâu sắc. Đầu rắn kiêu hãnh vươn cao, đội chiếc mũ vu