e": null}, {"source_product_id": "A001_155216000", "name": "Ca bia 0.52 L (q.tròn) - Misc Assortment - Trắng", "description": "Tuyển chọn từ những nguyên liệu quý hiếm mỗi sản phẩm của Misc Assortment đảm bảo những tiêu chí cao nhất về chất lượng. Sở hữu nhiều tính năng vượt trội siêu cứng chắc, mặt men sáng bóng, khó trầy xước. Misc Assortment được nhiều người ưa chuộng và lựa chọn bởi sự cao cấp, an toàn, bền đẹp và thân thiện với môi trường.", "product_url": "https://minhlong.com/products/ca-bia-0-52-l-q-tron-misc-assortment-trang-2", "category": "Misc Assortment", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 171720, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_155045432DU", "name": "Ca trà 0.5 L - Tulip IFP - Duyên Dáng", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/ca-tra-0-5-l-tulip-ifp-duyen-dang-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 332640, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_155045345", "name": "Ca trà 0.5 L - Tulip IFP - Sen Vàng", "description": "Khoác lên vẻ truyền thống, nền nã của loài hoa Á Đông nhưng lại không kém phần tinh tế hiện đại, những cánh sen bung tròn, phúc hậu ôm lấy nhụy đã được tái hiện sống động bằng màu xanh cobalt đặc trưng của cung đình Huế. Bức tranh chân thực và sống động về lá, cỏ và hoa sen như đưa người ngắm về với một làng quê Việt Nam vốn yên bình, trù phú... Nghệ nhân cũng khéo léo tạo nét vương giả bằng những chi tiết vẽ vàng 24k uyển chuyển trên từng cánh hoa, vành, tay cầm và nắp tạo nên sắc màu lấp lánh dưới sự phản chiếu của ánh sáng. Bộ sản phẩm thích hợp cho những buổi sum họp thân tình trong không gian yên bình, thư giãn vừa gần gũi vừa sang trọng.", "product_url": "https://minhlong.com/products/ca-tra-0-5-l-tulip-ifp-sen-vang-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 480600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_155045142", "name": "Ca trà 0.5 L - Tulip IFP - Sung Túc", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/ca-tra-0-5-l-tulip-ifp-sung-tuc-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 388800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_154019021", "name": "Ca trà 0.40 L - Camellia - Chỉ Xanh Dương", "description": "Dãy sản phẩm Camellia đa dạng các kiểu dáng với chất liệu men sứ sáng bóng, láng mịn được nung ở nhiệt độ cao. Không họa tiết cầu kỳ nhưng các sản phẩm Camellia luôn được lòng khách bởi màu sắc trang nhã, dù là trắng trơn hay viền chỉ vàng, chỉ xanh dương đều giúp lưu giữ vị ngon của tách trà nóng, của món ăn ngon và khơi gợi cảm hứng cho người thưởng thức.", "product_url": "https://minhlong.com/products/ca-tra-0-40-l-camellia-chi-xanh-duong-2", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 125280, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_154019000", "name": "Ca trà 0.40 L - Camellia - Trắng", "description": "Camellia trắng như như cô gái mộc mạc, trong sáng, mang nét duyên thầm và luôn tỏa hương thơm dịu dàng làm đắm say lòng người. Chẳng cần họa tiết rườm rà, Camellia trắng vẫn là lựa chọn hàng đầu của nhiều gia đình bởi kiểu dáng đơn giản nhưng vẫn tôn lên sự sang trọng, tiện nghi của không gian ẩm thực.", "product_url": "https://minhlong.com/products/ca-tra-0-40-l-camellia-trang-2", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 97200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153502000", "name": "Ca q.tròn 0.35 L - Misc Assortment - Trắng", "description": "Tuyển chọn từ những nguyên liệu quý hiếm mỗi sản phẩm của Misc Assortment đảm bảo những tiêu chí cao nhất về chất lượng. Sở hữu nhiều tính năng vượt trội siêu cứng chắc, mặt men sáng bóng, khó trầy xước. Misc Assortment được nhiều người ưa chuộng và lựa chọn bởi sự cao cấp, an toàn, bền đẹp và thân thiện với môi trường.", "product_url": "https://minhlong.com/products/ca-q-tron-0-35-l-misc-assortment-trang-2", "category": "Misc Assortment", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 102600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153169470", "name": "Ca trà 0.31 L - Gastroline - Đồng Tâm Xanh Dương", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Bộ sản phẩm nổi bật với vẻ đẹp sang trọng, kiểu dáng tinh tế và có thiết kế đột phá trong từng đường nét, chi tiết. Những họa tiết được thiết kế tinh xảo mang tính đối xứng, lặp lại tạo nên sự mới lạ, khác biệt và nét đẹp hiện đại, ấn tượng. Sự phối màu hài hòa giữa những họa tiết màu xanh dương trên nền sứ trắng và điểm nhấn viền chỉ vàng góp phần tăng thêm sự sang trọng, đẳng cấp. Những sản phẩm của Gastroline - Đồng Tâm Xanh Dương mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị và sự tiện nghi cho không gian sống.", "product_url": "https://minhlong.com/products/ca-tra-0-31-l-gastroline-dong-tam-xanh-duong-2", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 311040, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153169469", "name": "Ca trà 0.31 L - Gastroline - Đồng Tâm Xanh Lá", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Gastroline có thiết kế và kỹ thuật tạo hình sản phẩm đỉnh cao bởi độ khó thể hiện qua tạo hình ở những góc vuông cực kỳ sắc nét mà rất hiếm công ty gốm sứ nào trên thế giới có thể đạt được cho đến thời điểm hiện tại. Hoa văn Đồng Tâm Xanh Lá với những họa tiết được thiết kế tinh xảo mang tính đối xứng và đồng tâm tạo nên sự mới lạ, khác biệt và ấn tượng. Sự phối màu hài hòa giữa xanh lá và chỉ vàng làm nổi bật trên nền sứ trắng; mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị.", "product_url": "https://minhlong.com/products/ca-tra-0-31-l-gastroline-dong-tam-xanh-la-2", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 311040, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153169000", "name": "Ca trà 0.31 L - Gastroline - Trắng", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Bộ sản phẩm nổi bật với vẻ đẹp sang trọng, kiểu dáng tinh tế và có thiết kế đột phá trong từng đường nét, chi tiết. Những sản phẩm của Gastroline mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị và sự tiện nghi cho không gian sống.", "product_url": "https://minhlong.com/products/ca-tra-0-31-l-gastroline-trang-2", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 102600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153049000", "name": "Ca trà 0.30 L+ nắp - Sen IFP - Trắng Ngà", "description": "Các nghệ nhân đã khéo léo khắc họa vẻ đẹp giản dị và thuần khiết của hoa sen trên nền men sứ trắng ngà. Từng đường nét hoa sen hiện lên thanh thoát lúc dứt khoát, lúc lướt nhẹ bay cao làm toát lên dáng vẻ an nhiên, tự tại. Thưởng thức ẩm thực với bộ Sen IFP trắng ngà là tận hưởng những giây phút thư thái, bình yên trong tâm hồn.", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-nap-sen-ifp-trang-nga-2", "category": "Sen IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 158760, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153048176", "name": "Ca trà 0.30 L + nắp - Mẫu Đơn IFP - Thanh Trúc", "description": "Hoa Mẫu Đơn có vẻ đẹp vừa quyến rũ, sang trọng vừa tao nhã, nhẹ nhàng, cánh hoa mỏng manh và nhiều lớp. Các nghệ nhân Minh Long đã đưa những đường cong uốn lượn mềm mại của hoa mẫu đơn vào trong chi tiết thiết kế ở vành ly và tay cầm của bộ trà Mẫu Đơn IFP.", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-nap-mau-don-ifp-thanh-truc-2", "category": "Mẫu Đơn IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 259200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153048000", "name": "Ca trà + nắp 0.30 L - Mẫu Đơn IFP - Trắng Ngà", "description": "Hoa Mẫu Đơn có vẻ đẹp vừa quyến rũ, sang trọng vừa tao nhã, nhẹ nhàng, cánh hoa mỏng manh và nhiều lớp. Các nghệ nhân Minh Long đã đưa những đường cong uốn lượn mềm mại của hoa mẫu đơn vào trong chi tiết thiết kế ở vành ly và tay cầm của bộ trà Mẫu Đơn IFP.", "product_url": "https://minhlong.com/products/ca-tra-nap-0-30-l-mau-don-ifp-trang-nga-2", "category": "Mẫu Đơn IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 132840, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153020460", "name": "Ca trà 0.30 L + nắp - Hoàng Cung - Hoàng Liên", "description": "Bộ sản phẩm Hoàng Liên được thiết kế đẳng cấp với phong cách hoàng gia, gồm nhiều sản phẩm với đầy đủ các chức năng phục vụ bữa tiệc sang trọng, quyền quý nhất. Nét vương giả từ các họa tiết đặc trưng, truyền thống Việt Nam (hoa sen, dương xỉ, linh vật đầu rồng mỏ phượng) được nghệ thuật hóa khéo léo trên nền vàng trang nhã, giúp Hoàng Liên toát lên vẻ đẹp tinh tế, phú quý mang đẳng cấp quốc tế.", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-nap-hoang-cung-hoang-lien-2", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2257200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153020208", "name": "Ca trà 0.30 L + nắp - Hoàng Cung - Lạc Hồng", "description": "Lạc Hồng với ý nghĩa bay lên từ cội nguồn dân tộc. Minh Long đã cho ra đời dòng sản phẩm Lạc Hồng mang thông điệp ngàn xưa từ những gì đẹp đẽ, linh thiêng cho tâm hồn và khát vọng bay lên, là niềm tự hào sáng tạo và thăng hoa suốt ngàn đời của dân tộc vào bữa ăn hàng ngày của gia đình nhằm nhắc nhớ con cháu luôn hướng về cội nguồn dân tộc và mang đến cho gia đình bữa cơm thêm trọn vị, ấm cúng hơn. Sản phẩm có lối thiết kế tinh tế, trang nhã. Trên nền sứ sáng bóng, các họa tiết, hoa văn được trang trí trên tông xanh cobalt (blue Huế) đặc trưng, mang ý nghĩa thịnh vượng và sang trọng.", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-nap-hoang-cung-lac-hong-2", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 496800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153009207v", "name": "Ca trà 0.30 L + nắp - Mẫu Đơn - Tịnh Tâm Vàng", "description": "Hoa Mẫu Đơn có vẻ đẹp vừa quyến rũ, sang trọng vừa tao nhã, nhẹ nhàng, cánh hoa mỏng manh và nhiều lớp. Các nghệ nhân Minh Long đã đưa những đường cong uốn lượn mềm mại của hoa mẫu đơn vào trong chi tiết thiết kế ở vành ly và tay cầm của bộ trà Mẫu Đơn.", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-nap-mau-don-tinh-tam-vang-2", "category": "Mẫu Đơn", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 288360, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_15300400003", "name": "Bộ ca lọc trà - Misc Assortment - Trắng", "description": "Mỗi sản phẩm của Jasmine trắng đều bắt đầu bằng màu trắng - biểu tượng của sự hoàn hảo, tinh khôi và giản dị. Không rực rỡ như các màu sắc khác nhưng trên nền sứ bền vững, phủ men cao cấp và được nung ở nhiệt độ rất cao, dù đặt ở bất kỳ đâu thì Jasmine trắng đều chiếm được cảm tình người khác. Nếu bạn là fan của trắng tinh khôi, yêu thích những kiểu dáng đơn giản nhưng vẫn giữ nguyên vẹn sự sang trọng và trang nhã thì hãy chọn Jasime trắng nhé!", "product_url": "https://minhlong.com/products/bo-ca-loc-tra-misc-assortment-trang-2", "category": "Misc Assortment", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 155520, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_153004000", "name": "Ca trà 0.30 L - Jasmine - Trắng", "description": "Mỗi sản phẩm của Jasmine trắng đều bắt đầu bằng màu trắng - biểu tượng của sự hoàn hảo, tinh khôi và giản dị. Không rực rỡ như các màu sắc khác nhưng trên nền sứ bền vững, phủ men cao cấp và được nung ở nhiệt độ rất cao, dù đặt ở bất kỳ đâu thì Jasmine trắng đều chiếm được cảm tình người khác. Nếu bạn là fan của trắng tinh khôi, yêu thích những kiểu dáng đơn giản nhưng vẫn giữ nguyên vẹn sự sang trọng và trang nhã thì hãy chọn Jasime trắng nhé!", "product_url": "https://minhlong.com/products/ca-tra-0-30-l-jasmine-trang-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 93960, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140821000", "name": "Muỗng canh - Jasmine Lys - Trắng Ngà", "description": "Jasmine Ly's có màu men sứ trắng ngà, đa dạng chủng loại từ chén, dĩa, tô, tách...có kiểu dáng thiết kế đồng nhất, đáp ứng đầy đủ nhu cầu sử dụng cho các loại bàn tiệc đa dạng và phong phú của khách hàng. Đặc tính sản phẩm: Thân sứ siêu cứng với công nghệ phối liệu đặc biệt: Sử dụng bền lâu, hạn chế bể mẻ trong quá trình tẩy rửa. Mặt men cứng, chắc: Khó trầy xước khi sử dụng dao, muỗng, nĩa thường xuyên, giữ sản phẩm luôn mới sau thời gian dài sử dụng. Ứng dụng công nghệ Nano cho bề mặt men láng bóng: Giúp cho sản phẩm khó bám bẩn kể cả dầu mỡ, tiết kiệm thời gian. Kiểu dáng đa dạng sang trọng phù hợp với nhiều không gian ăn uống khác nhau. Độ sốc nhiệt cao (có thể sử dụng từ nóng sang lạnh và ngược lại với độ sốc nhiệt từ 0 đến 200 độ C).", "product_url": "https://minhlong.com/products/muong-canh-jasmine-lys-trang-nga-2", "category": "Jasmine Lys", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 139320, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140429487", "name": "Muỗng - Hoàng Cung - Sen Ngọc Bích", "description": "Bộ sản phẩm Sen Ngọc Bích Nghệ thuật hóa hình ảnh quốc hoa Việt Nam, vốn là biểu trưng của nét đẹp giản dị và thanh khiết, nghệ thuật lại trên sứ đầy khéo léo, uyển chuyển, kết hợp cùng màu xanh ngọc bích trang nhã, thanh lịch tạo nên bộ bàn ăn mang nét đẹp tinh tế và thấm đượm hồn Việt. Trên nền xanh ngọc bích quý phái, cùng sắc vàng vương giả, sang trọng, họa tiết sen được khắc họa một cách sinh động với các đường nét thanh thoát, sắc sảo, đầy hồn sắc. Với thiết kế sang trọng, hiện đại, bộ sản phẩm thích hợp bày trí trong nhiều không gian, đồng thời thể hiện gu thẩm mỹ, sự sáng tạo và phong cách riêng của chủ sở hữu.", "product_url": "https://minhlong.com/products/muong-hoang-cung-sen-ngoc-bich-2", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 799200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140406293", "name": "Muỗng - Tulip IFP - Ngân Sa", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà Ngân sa tạo điểm nhấn bởi những đường vân trang trí mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/muong-tulip-ifp-ngan-sa-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 83160, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140406176", "name": "Muỗng - Tulip IFP - Thanh Trúc", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/muong-tulip-ifp-thanh-truc-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 51840, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140406043", "name": "Muỗng - Tulip IFP - Chỉ Bạch Kim", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ. Lưu ý: Không dùng sản phẩm trong máy rửa chén, lò vi sóng.", "product_url": "https://minhlong.com/products/muong-tulip-ifp-chi-bach-kim-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 62640, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140406014", "name": "Muỗng - Tulip IFP - Chỉ Vàng", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/muong-tulip-ifp-chi-vang-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 62640, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140406000", "name": "Muỗng - Tulip IFP - Trắng Ngà", "description": "Lấy cảm hứng Tulip - loài hoa xinh đẹp ở xứ sở Hà Lan, tượng trưng sự giàu có, nổi tiếng, tình yêu và cuộc sống vĩnh cửu, nhà chế tác đã thổi hồn vào dòng Tulip Ngà một vẻ đẹp mộc mạc, giản dị nhưng vẫn giữ được nét sống động, độc đáo vốn có của sản phẩm. Hòa quyện cùng men sứ ngà sang trọng, Tulip Ngà tạo điểm nhấn bởi những đường nét mảnh mai, thiết kế thon dần về phía đáy phù hợp với xu hướng ẩm thực. Dòng sản phẩm Tulip Ngà thích hợp trong việc trang trí và trình bày món ăn thêm đẹp mắt, giúp tô điểm sự sang trọng cho bàn ăn gia đình đồng thời thể hiện gu thẩm mỹ, sáng tạo và phong cách riêng của gia chủ.", "product_url": "https://minhlong.com/products/muong-tulip-ifp-trang-nga-2", "category": "Tulip IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 33480, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401489", "name": "Muỗng - Jasmine - Xanh Ngọc", "description": "Lấy cảm hứng từ hoa nhài thuần khiết với hương thơm ngào ngạt, vẻ đẹp thanh tao được nhiều người yêu thích, chúng tôi đã chế tác nên bộ bàn ăn Jasmine với những đường nét uốn lượn mềm mại.", "product_url": "https://minhlong.com/products/muong-jasmine-xanh-ngoc-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 226800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401485", "name": "Muỗng - Jasmine - Lộc Lạc", "description": "Tái hiện sống động nền văn hóa hưng thịnh xưa với những hoa văn truyền thống được khắc họa tinh tế, Lộc Lạc vừa mang nét đẹp hoài cổ vừa có phong cách hiện đại. Sự phối màu hài hòa giữa sắc xanh cobalt trang nhã, thanh lịch hòa lẫn với sứ trắng thanh khiết, tạo nên sự sang trọng, nhã nhặn và tinh tế cho từng sản phẩm. Bộ sản phẩm Lộc Lạc gợi nhớ về thời kỳ lịch sử văn hóa dân tộc cùng ước vọng phát triển, thịnh vượng.", "product_url": "https://minhlong.com/products/muong-jasmine-loc-lac-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 39960, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401478", "name": "Muỗng - Jasmine - Hoa Mai", "description": "Mai vàng rực rỡ của miền Nam được ví như biểu tượng của sự may mắn, thịnh vượng. Cứ mỗi độ mai vàng khoe sắc thắm, người người lại rạo rực, hân hoan về một mùa xuân mới. Từ ý nghĩa đó, Minh Long nghệ thuật hóa sinh động vẻ đẹp của loài hoa đặc trưng này lên bộ bàn ăn, với những cánh hoa bung nở tròn đầy như gửi lời chúc một năm mới tài lộc, may mắn.", "product_url": "https://minhlong.com/products/muong-jasmine-hoa-mai-3", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 74520, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401470", "name": "Muỗng - Jasmine - Đồng Tâm Xanh Dương", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Bộ sản phẩm nổi bật với vẻ đẹp sang trọng, kiểu dáng tinh tế và có thiết kế đột phá trong từng đường nét, chi tiết. Những họa tiết được thiết kế tinh xảo mang tính đối xứng, lặp lại tạo nên sự mới lạ, khác biệt và nét đẹp hiện đại, ấn tượng. Sự phối màu hài hòa giữa những họa tiết màu xanh dương trên nền sứ trắng và điểm nhấn viền chỉ vàng góp phần tăng thêm sự sang trọng, đẳng cấp. Những sản phẩm của Gastroline - Đồng Tâm Xanh Dương mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị và sự tiện nghi cho không gian sống.", "product_url": "https://minhlong.com/products/muong-jasmine-dong-tam-xanh-duong-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 103680, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401469", "name": "Muỗng - Jasmine - Đồng Tâm Xanh Lá", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Bộ sản phẩm nổi bật với vẻ đẹp sang trọng, kiểu dáng tinh tế và có thiết kế đột phá trong từng đường nét, chi tiết. Những họa tiết được thiết kế tinh xảo mang tính đối xứng, lặp lại tạo nên sự mới lạ, khác biệt và nét đẹp hiện đại, ấn tượng. Sự phối màu hài hòa giữa những họa tiết màu xanh lá trên nền sứ trắng và điểm nhấn viền chỉ vàng góp phần tăng thêm sự sang trọng, đẳng cấp. Những sản phẩm của Gastroline - Đồng Tâm Xanh Lá mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị và sự tiện nghi cho không gian sống.", "product_url": "https://minhlong.com/products/muong-jasmine-dong-tam-xanh-la-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 103680, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401391", "name": "Muỗng - Jasmine - Hoa hồng đen", "description": "Lấy cảm hứng từ hoa nhài thuần khiết với hương thơm ngào ngạt, vẻ đẹp thanh tao được nhiều người yêu thích, chúng tôi đã chế tác nên bộ bàn ăn Jasmine với những đường nét uốn lượn mềm mại.", "product_url": "https://minhlong.com/products/muong-jasmine-hoa-hong-den-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 192240, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401376", "name": "Muỗng - Jasmine - Trống Đồng", "description": "Tái hiện sống động biểu tượng văn hóa thiêng liêng và nền văn minh của người Việt cổ trên sứ chính là cách Minh Long lưu giữ ký ức lịch sử trong cuộc sống hiện đại. Sự phối màu tươi trẻ, mới mẻ (cam đỏ, xanh lam Huế, vàng) trên nền hoa văn Trống Đồng truyền thống cùng kiểu dáng sắc cạnh và đường loe mang phong cách rất Tây. Ẩn chứa sự kỳ công của người làm nghề, Trống đồng làm sống dậy vẻ đẹp, linh hồn của đất nước, dân tộc thủa sơ khai, nơi thăng hoa tài năng, kỹ thuật minh triết, trí tuệ sáng tạo và đời sống tinh thần của người Việt. Bộ sản phẩm cao cấp không chỉ là tâm huyết và tấm lòng trân trọng giá trị cổ xưa đồng thời còn là niềm tự hào về hào khí, sức sống mãnh liệt 4000 năm nước Việt.", "product_url": "https://minhlong.com/products/muong-jasmine-trong-dong-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 213840, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401345", "name": "Muỗng - Jasmine - Sen Vàng", "description": "Khoác lên vẻ truyền thống, nền nã của loài hoa Á Đông nhưng lại không kém phần tinh tế hiện đại, những cánh sen bung tròn, phúc hậu ôm lấy nhụy đã được tái hiện sống động bằng màu xanh cobalt đặc trưng của cung đình Huế. Bức tranh chân thực và sống động về lá, cỏ và hoa sen như đưa người ngắm về với một làng quê Việt Nam vốn yên bình, trù phú... Nghệ nhân cũng khéo léo tạo nét vương giả bằng những chi tiết vẽ vàng 24k uyển chuyển trên từng cánh hoa, vành, tay cầm và nắp tạo nên sắc màu lấp lánh dưới sự phản chiếu của ánh sáng. Bộ sản phẩm thích hợp cho những buổi sum họp thân tình trong không gian yên bình, thư giãn vừa gần gũi vừa sang trọng.", "product_url": "https://minhlong.com/products/muong-jasmine-sen-vang-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 147960, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401302", "name": "Muỗng - Jasmine - Cát Tường", "description": "Trên nền sứ trắng, những nhành hoa Cát tường mỏng như lụa dịu dàng khoe sắc như con gái đôi mươi. Cầm trên tay bộ trà hay bộ bàn ăn này, ta đều cảm nhận vẻ đẹp nhẹ nhàng, ngọt ngào và quý phái. Đây cũng là một món quà được nhiều người lựa chọn, đặc biệt là tặng bạn gái hoặc người phụ nữ của mình để gửi đi thông điệp yêu thương, cầu may mắn và bình an cho người thương.", "product_url": "https://minhlong.com/products/muong-jasmine-cat-tuong-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 74520, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401267", "name": "Muỗng - Jasmine - Cỏ tím", "description": "Daisy Cỏ Tím là bộ sản phẩm kết hợp giữa phong cách cổ điển và hiện đại. Những nhành cỏ tím uốn lượn mềm mại trên nền men sứ sáng bóng tạo nên sự thanh thoát nhưng không kém phần sang trong trong từng bình trà, tách, tô, chén chấm… Màu tím còn tượng trưng cho sự thủy chung, gợi nhắc người thương luôn quý trọng hạnh phúc gia đình.", "product_url": "https://minhlong.com/products/muong-jasmine-co-tim-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 39960, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401208", "name": "Muỗng - Jasmine - Lạc Hồng", "description": "Lạc Hồng với ý nghĩa bay lên từ cội nguồn dân tộc. Minh Long đã cho ra đời dòng sản phẩm Lạc Hồng mang thông điệp ngàn xưa từ những gì đẹp đẽ, linh thiêng cho tâm hồn và khát vọng bay lên, là niềm tự hào sáng tạo và thăng hoa suốt ngàn đời của dân tộc vào bữa ăn hàng ngày của gia đình nhằm nhắc nhớ con cháu luôn hướng về cội nguồn dân tộc và mang đến cho gia đình bữa cơm thêm trọn vị, ấm cúng hơn. Sản phẩm có lối thiết kế tinh tế, trang nhã. Trên nền sứ sáng bóng, các họa tiết, hoa văn được trang trí trên tông xanh cobalt (blue Huế) đặc trưng, mang ý nghĩa thịnh vượng và sang trọng.", "product_url": "https://minhlong.com/products/muong-jasmine-lac-hong-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 110160, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401089", "name": "Muỗng - Jasmine - Hương Biển Kem", "description": "Kỹ lưỡng từ khâu nguyên liệu đến quy trình sản xuất, trau chuốt từ kiểu dáng đến màu sắc hoa văn, bộ bàn ăn Camellia mang phong cách mới mẻ với họa tiết nghêu, sò, ốc, hến... như thổi cả làn gió biển tươi mát vào tâm hồn. Cộng với gam màu trắng-kem nhẹ nhàng, trang nhã, Hương Biển Kem luôn tạo cho người khác cảm giác sảng khoái, mọi bực dọc sau ngày làm việc mệt mỏi như tan biến trước thiên nhiên biển cả tuyệt vời.", "product_url": "https://minhlong.com/products/muong-jasmine-huong-bien-kem-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 71280, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140401038", "name": "Muỗng - Jasmine - Hồn Việt", "description": "Mang phong cách cung đình, vương tộc nhưng vẫn đậm đà hình ảnh văn hóa dân gian Việt Nam, sự sáng tạo nghệ thuật thể hiện ở từng nét vẽ có tính thẩm mỹ riêng tạo nên phần hồn, chiều sâu văn hóa của từng tác phẩm. Từ những hoa văn đậm chất làng quê Việt, khắc họa đời sống sinh hoạt của người dân (bộ Hồn Việt, Hồn quê), linh vật biểu tượng thiêng liêng như chim lạc, trống đồng (Bộ Lạc Hồng, Cội Nguồn), cho tới họa tiết cung đình xưa như rồng phượng, hoa sen (Bộ Quốc sắc, Cẩm Tú, Hoàng Bào, Sen vàng)… đều được khắc họa sinh động và tinh tế hình ảnh một Việt giàu giàu bản sắc, thuần hậu. Đặc biệt, bộ sản phẩm còn đánh dấu thành tựu của Minh Long trong kỹ thuật làm đồ sứ, từ những chi tiết vẽ vàng 24k tới việc phục chế màu sắc hoàng tộc, quyền quý và kỹ thuật nung màu dưới men ở nhiệt độ cao làm toát lên nét cao sang, quý phái nhưng vô cùng gần gũi. Sở hữu bộ sản phẩm Hoàng Cung chính là sự trân trọng, tôn vinh giá trị những “bảo vật” đậm chất văn hóa Việt và niềm ước vọng về sự trường tồn, phồn thịnh của dân tộc.", "product_url": "https://minhlong.com/products/muong-jasmine-hon-viet-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 147960, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140230000", "name": "Muỗng đường - Jasmine - Trắng", "description": "Mỗi sản phẩm của Jasmine trắng đều bắt đầu bằng màu trắng - biểu tượng của sự hoàn hảo, tinh khôi và giản dị. Không rực rỡ như các màu sắc khác nhưng trên nền sứ bền vững, phủ men cao cấp và được nung ở nhiệt độ rất cao, dù đặt ở bất kỳ đâu thì Jasmine trắng đều chiếm được cảm tình người khác. Nếu bạn là fan của trắng tinh khôi, yêu thích những kiểu dáng đơn giản nhưng vẫn giữ nguyên vẹn sự sang trọng và trang nhã thì hãy chọn Jasime trắng nhé!", "product_url": "https://minhlong.com/products/muong-duong-jasmine-trang-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 29160, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140124460", "name": "Muỗng tương ớt - Jasmine - Hoàng Liên", "description": "Bộ sản phẩm Hoàng Liên được thiết kế đẳng cấp với phong cách hoàng gia, gồm nhiều sản phẩm với đầy đủ các chức năng phục vụ bữa tiệc sang trọng, quyền quý nhất. Nét vương giả từ các họa tiết đặc trưng, truyền thống Việt Nam (hoa sen, dương xỉ, linh vật đầu rồng mỏ phượng) được nghệ thuật hóa khéo léo trên nền vàng trang nhã, giúp Hoàng Liên toát lên vẻ đẹp tinh tế, phú quý mang đẳng cấp quốc tế.", "product_url": "https://minhlong.com/products/muong-tuong-ot-jasmine-hoang-lien-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 118800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_131009000", "name": "Khay đường 10.5 x 7 cm - Misc Assortment - Trắng", "description": "Tuyển chọn từ những nguyên liệu quý hiếm mỗi sản phẩm của Misc Assortment đảm bảo những tiêu chí cao nhất về chất lượng. Sở hữu nhiều tính năng vượt trội siêu cứng chắc, mặt men sáng bóng, khó trầy xước. Misc Assortment được nhiều người ưa chuộng và lựa chọn bởi sự cao cấp, an toàn, bền đẹp và thân thiện với môi trường.", "product_url": "https://minhlong.com/products/khay-duong-10-5-x-7-cm-misc-assortment-trang-2", "category": "Misc Assortment", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 50760, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_09349", "name": "Bộ đồ ăn 09 sản phẩm - Daisy - Hồng Mai", "description": "Hoa mai là biểu tượng của sự may mắn, sung túc và hạnh phúc. Nổi bật trên nền sứ sáng bóng là hình ảnh những nhành mai đua nhau khoe sắc. Từ búp, đọt non, cánh hoa đến nhụy hoa đều được đội ngũ nghệ nhân của Minh Long I phác họa tinh tế và sống động. Những búp mai đang khỏe khoắn, e ấp rồi bung rộ thắm tươi như báo hiệu một mùa mới an lành, ngập tràn hạnh phúc. Sở hữu Daisy Hồng Mai là chủ sở hữu tự tặng cho mình những điều tốt đẹp nhất trong cuộc sống. CHI TIẾT BỘ ĐỒ ĂN: Chén cơm 11 cm 06 Cái Dĩa sâu lòng 23 cm 01 Cái Dĩa tròn ảo 26 cm 01 Cái Tô trung 20 cm 01 Cái", "product_url": "https://minhlong.com/products/bo-do-an-09-san-pham-daisy-hong-mai-2", "category": "Daisy", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 886680, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_090706000", "name": "Hủ muối - Jasmine - Trắng", "description": "Mỗi sản phẩm của Jasmine trắng đều bắt đầu bằng màu trắng - biểu tượng của sự hoàn hảo, tinh khôi và giản dị. Không rực rỡ như các màu sắc khác nhưng trên nền sứ bền vững, phủ men cao cấp và được nung ở nhiệt độ rất cao, dù đặt ở bất kỳ đâu thì Jasmine trắng đều chiếm được cảm tình người khác. Nếu bạn là fan của trắng tinh khôi, yêu thích những kiểu dáng đơn giản nhưng vẫn giữ nguyên vẹn sự sang trọng và trang nhã thì hãy chọn Jasime trắng nhé!", "product_url": "https://minhlong.com/products/hu-muoi-jasmine-trang-2", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 50760, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_082529350", "name": "Lọ giấm 0.25 L + nắp - Anna Lys - Chữ Nước mắm", "description": "Sản phẩm được làm từ sứ cao cấp, an toàn sử dụng trong lò vi sóng, máy rửa chén. Được dùng để đựng các chất lỏng: nước tương, nước mắm, giấm... Đặc tính sản phẩm: Thân sứ siêu cứng với công nghệ phối liệu đặc biệt: Sử dụng bền lâu, hạn chế bể mẻ trong quá trình tẩy rửa. Mặt men cứng, chắc: Khó trầy xước khi sử dụng dao, muỗng, nĩa thường xuyên, giữ sản phẩm luôn 