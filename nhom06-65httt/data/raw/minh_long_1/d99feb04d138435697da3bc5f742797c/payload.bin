available": null}, {"source_product_id": "A001_042361480", "name": "Dĩa súp 23 cm - Camellia - Hoa Đào", "description": "Đào thắm tươi của miền Bắc được xem là loài hoa mang lại sự an lành, hạnh phúc mỗi khi xuân về. “Thấy hoa đào là thấy Tết”, thấy đoàn viên. Những búp đào khỏe khoắn, e ấp rồi bung rộ thắm tươi trên nền sứ sáng bóng vừa tượng trưng cho sự sinh sôi, nảy nở vừa gợi nhớ về ý nghĩa của Tết sum họp, đoàn viên.", "product_url": "https://minhlong.com/products/dia-sup-23-cm-camellia-hoa-dao", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 313200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_042065480", "name": "Dĩa sâu lòng - Camellia - Hoa Đào", "description": "Đào thắm tươi của miền Bắc được xem là loài hoa mang lại sự an lành, hạnh phúc mỗi khi xuân về. “Thấy hoa đào là thấy Tết”, thấy đoàn viên. Những búp đào khỏe khoắn, e ấp rồi bung rộ thắm tươi trên nền sứ sáng bóng vừa tượng trưng cho sự sinh sôi, nảy nở vừa gợi nhớ về ý nghĩa của Tết sum họp, đoàn viên.", "product_url": "https://minhlong.com/products/dia-sau-long-camellia-hoa-dao", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 250560, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_01134048703N", "name": "Bộ trà 1.3 L - Hoàng cung - Sen Ngọc Bích", "description": "Bộ sản phẩm Sen Ngọc Bích Nghệ thuật hóa hình ảnh quốc hoa Việt Nam, vốn là biểu trưng của nét đẹp giản dị và thanh khiết, nghệ thuật lại trên sứ đầy khéo léo, uyển chuyển, kết hợp cùng màu xanh ngọc bích trang nhã, thanh lịch tạo nên bộ bàn ăn mang nét đẹp tinh tế và thấm đượm hồn Việt. Trên nền xanh ngọc bích quý phái, cùng sắc vàng vương giả, sang trọng, họa tiết sen được khắc họa một cách sinh động với các đường nét thanh thoát, sắc sảo, đầy hồn sắc. Với thiết kế sang trọng, hiện đại, bộ sản phẩm thích hợp bày trí trong nhiều không gian, đồng thời thể hiện gu thẩm mỹ, sự sáng tạo và phong cách riêng của chủ sở hữu.", "product_url": "https://minhlong.com/products/bo-tra-1-3-l-hoang-cung-sen-ngoc-bich-1", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 52606800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_34270103803", "name": "Bộ khay rượu 0.27 L - Hoàng Cung - Hồn Việt", "description": "Hoàng Cung là dãy sản phẩm cao cấp của Minh Long, mang phong cách cung đình, vương tộc nhưng vẫn đậm đà hình ảnh văn hóa dân gian Việt Nam. Sự sáng tạo nghệ thuật thể hiện ở từng nét vẽ có tính thẩm mỹ riêng tạo nên phần hồn, chiều sâu văn hóa của từng sản phẩm. Bộ sản phẩm Hoàng Cung - Hồn Việt khắc họa chân thật hình ảnh làng quê Việt và đời sống sinh hoạt của người dân một cách sinh động và tinh tế. Sở hữu bộ sản phẩm Hoàng Cung - Hồn Việt chính là sự trân trọng, tôn vinh giá trị bản sắc văn hóa Việt và niềm ước vọng về sự trường tồn, phồn thịnh của dân tộc CHI TIẾT BỘ KHAY RƯỢU: Bình rượu 0.27 L + Nắp 01 Cái Chum rượu 0.05 L 06 Cái Khay rượu 21.5 cm 01 Cái", "product_url": "https://minhlong.com/products/bo-khay-ruou-0-27-l-hoang-cung-hon-viet", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2557440, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_283202201", "name": "Tô trái cây - Royal - Tứ Quý (Vàng)", "description": "Cùng với bánh chưng xanh, câu đối đỏ, tô, dĩa trái cây luôn là \"bạn đồng hành\" không thể thiếu để dâng cúng ông bà, tổ tiên hay bày biện đón khách gần xa mỗi dịp Tết đến Xuân về. Mỗi tô, dĩa trái cây được thiết kế hài hòa, đẹp mắt, không chỉ thể hiện lòng thành kính với tổ tiên, giúp không gian thêm ấm cúng mà còn là lời chúc bình an, may mắn dịp đầu năm.", "product_url": "https://minhlong.com/products/to-trai-cay-royal-tu-quy-vang", "category": "Royal", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1501200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_283202014", "name": "Tô trái cây - Royal - Chỉ Vàng", "description": "Cùng với bánh chưng xanh, câu đối đỏ, tô, dĩa trái cây luôn là \"bạn đồng hành\" không thể thiếu để dâng cúng ông bà, tổ tiên hay bày biện đón khách gần xa mỗi dịp Tết đến Xuân về. Mỗi tô, dĩa trái cây được thiết kế hài hòa, đẹp mắt, không chỉ thể hiện lòng thành kính với tổ tiên, giúp không gian thêm ấm cúng mà còn là lời chúc bình an, may mắn dịp đầu năm.", "product_url": "https://minhlong.com/products/to-trai-cay-royal-chi-vang", "category": "Royal", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 1188000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_693059HXDV", "name": "Bình hoa Hoàng Kim 30 cm - Bình Hoa - Hỏa Biến Xanh Dương", "description": "Bình hoa Hoàng Kim là chế tác ra đời từ tài hoa, tâm huyết của đội ngũ nghệ nhân Minh Long, kết hợp cùng kỹ thuật sản xuất đỉnh cao. Bình được thiết kế có kiểu dáng độc đáo, mới lạ với những đường kẻ dọc giàu nghệ thuật và tinh tế. Đặc biệt sự kết hợp giữa sắc trắng và điểm xuyết những chi tiết được nhũ vàng mang đến sự đẳng cấp, sang trọng cho tác phẩm. Được tạo hình công phu, cân đối và nung ở nhiệt độ cao, bình hoa Hoàng Kim có màu men sáng bóng, bền đẹp theo thời gian. Chế tác là vật phẩm để cắm hoa, trang trí, giúp không gian trưng bày trở nên sang trọng và cuốn hút hơn.", "product_url": "https://minhlong.com/products/binh-hoa-hoang-kim-30-cm-hoa-bien-xanh-duong", "category": "Bình Hoa", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2127600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_063095488", "name": "Thố 2 quai 0.3 L - Gastroline - Kim Ngọc", "description": "Bộ sản phẩm Gastroline Kim Ngọc toát lên vẻ đẹp hiện đại và cuốn hút trong từng đường nét, tạo nên bức tranh sống động cho không gian ẩm thực. Với gam màu hiện đại, kiểu dáng thanh thoát phù hợp nhiều phong cách ẩm thực, Gastroline Kim Ngọc là nguồn cảm hứng bất tận cho đầu bếp thỏa thức sáng tạo và biến tấu món ăn thành một tác phẩm nghệ thuật. Đặc biệt, Gastroline là một trong những dòng sản phẩm trứ danh của Minh Long cùng nhà thiết kế Hans Wilhelm Seitz (nhà thiết kế đẳng cấp của Đức) từng được vinh danh là thiết kế có “ý tưởng thiết kế sản phẩm xuất sắc” tại giải Red Dot Design Award 2019 - Cuộc thi thiết kế quy mô và uy tín nhất toàn cầu.", "product_url": "https://minhlong.com/products/tho-2-quai-0-3-l-gastroline-kim-ngoc-1", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 517320, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_140429488", "name": "Muỗng - Hoàng Cung - Kim Ngọc", "description": "Bộ sản phẩm Gastroline Kim Ngọc toát lên vẻ đẹp hiện đại và cuốn hút trong từng đường nét, tạo nên bức tranh sống động cho không gian ẩm thực. Với gam màu hiện đại, kiểu dáng thanh thoát phù hợp nhiều phong cách ẩm thực, Gastroline Kim Ngọc là nguồn cảm hứng bất tận cho đầu bếp thỏa thức sáng tạo và biến tấu món ăn thành một tác phẩm nghệ thuật. Đặc biệt, Gastroline là một trong những dòng sản phẩm trứ danh của Minh Long cùng nhà thiết kế Hans Wilhelm Seitz (nhà thiết kế đẳng cấp của Đức) từng được vinh danh là thiết kế có “ý tưởng thiết kế sản phẩm xuất sắc” tại giải Red Dot Design Award 2019 - Cuộc thi thiết kế quy mô và uy tín nhất toàn cầu.", "product_url": "https://minhlong.com/products/muong-hoang-cung-kim-ngoc-1", "category": "Hoàng Cung", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 320760, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_541925488", "name": "Dĩa tròn - Gastroline - Kim Ngọc", "description": "Bộ sản phẩm Gastroline Kim Ngọc toát lên vẻ đẹp hiện đại và cuốn hút trong từng đường nét, tạo nên bức tranh sống động cho không gian ẩm thực. Với gam màu hiện đại, kiểu dáng thanh thoát phù hợp nhiều phong cách ẩm thực, Gastroline Kim Ngọc là nguồn cảm hứng bất tận cho đầu bếp thỏa thức sáng tạo và biến tấu món ăn thành một tác phẩm nghệ thuật. Đặc biệt, Gastroline là một trong những dòng sản phẩm trứ danh của Minh Long cùng nhà thiết kế Hans Wilhelm Seitz (nhà thiết kế đẳng cấp của Đức) từng được vinh danh là thiết kế có “ý tưởng thiết kế sản phẩm xuất sắc” tại giải Red Dot Design Award 2019 - Cuộc thi thiết kế quy mô và uy tín nhất toàn cầu.", "product_url": "https://minhlong.com/products/dia-tron-gastroline-kim-ngoc", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 407160, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_632327488", "name": "Dĩa súp 23 cm - Gastroline - Kim Ngọc", "description": "Bộ sản phẩm Gastroline Kim Ngọc toát lên vẻ đẹp hiện đại và cuốn hút trong từng đường nét, tạo nên bức tranh sống động cho không gian ẩm thực. Với gam màu hiện đại, kiểu dáng thanh thoát phù hợp nhiều phong cách ẩm thực, Gastroline Kim Ngọc là nguồn cảm hứng bất tận cho đầu bếp thỏa thức sáng tạo và biến tấu món ăn thành một tác phẩm nghệ thuật. Đặc biệt, Gastroline là một trong những dòng sản phẩm trứ danh của Minh Long cùng nhà thiết kế Hans Wilhelm Seitz (nhà thiết kế đẳng cấp của Đức) từng được vinh danh là thiết kế có “ý tưởng thiết kế sản phẩm xuất sắc” tại giải Red Dot Design Award 2019 - Cuộc thi thiết kế quy mô và uy tín nhất toàn cầu.", "product_url": "https://minhlong.com/products/dia-sup-23-cm-gastroline-kim-ngoc-1", "category": "Gastroline", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 761400, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_availab