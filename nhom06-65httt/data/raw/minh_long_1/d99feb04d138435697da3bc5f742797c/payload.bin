cription": null, "product_url": "https://minhlong.com/products/bit-mat-bat-de-hoa-van-t-tri-bach-kim", "category": "Tượng", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2872800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_011346266", "name": "Bình trà 1.3 L - Đài Các - Trang Trí Bạch Kim", "description": "Bộ sản phẩm Đài các toát lên vẻ đẹp kiêu sa, lộng lẫy theo phong cách quyền quý hoàng gia. Bộ sản phẩm có kiểu dáng sang trọng, nhiều đường nét được cách điệu, uốn lượn với dáng điệu mềm mại, mảnh mai. Cái tài của các nghệ nhân là đã khéo léo viền chỉ vàng ở những điểm nổi bật như vành chén, vành đĩa, tay cầm và nắp bình trà, trong đó nổi bật là núm sen vàng sang trọng. Hoa văn được nhấn nhá bằng những đường viền óng ánh vô cùng đẹp mắt, , càng tôn lên vẻ đẹp đẳng cấp của không gian ẩm thực cũng như phong cách thẩm mỹ của chủ sở hữu.", "product_url": "https://minhlong.com/products/binh-tra-1-3-l-nap-hoa-van-t-tri-bach-kim", "category": "Đài Các", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2600640, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_010846014", "name": "Bình trà + nắp - Đài Các IFP - Chỉ vàng", "description": null, "product_url": "https://minhlong.com/products/binh-tra-1-3-l-nap-hoa-van-chi-vang", "category": "Đài Các IFP", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 2124360, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_011346043", "name": "Bình trà 1.3 L - Đài Các - Chỉ Bạch Kim", "description": "Giới quý tộc Châu Âu xưa gắn liền với hình ảnh những buổi trà chiều kiêu sa với những chiếc bánh ngọt cầu kỳ. Bộ trà Đài Các được các nghệ nhân của Minh Long truyền tải hết sự kiêu sa, quyền quý của quý tộc Châu Âu thông qua những hoa văn lộng lẫy khắc họa trên thân bình hay đường c