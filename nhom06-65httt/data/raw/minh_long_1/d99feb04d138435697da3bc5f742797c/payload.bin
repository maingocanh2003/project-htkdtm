{"supplier": {"supplier_name": "Công ty TNHH Minh Long I", "tax_code": null, "address": "333 Hưng Định 24, Thuận An", "province": "Bình Dương", "website": "https://minhlong.com", "phone": null, "business_type": "sản xuất", "declared_capacity_note": null}, "products": [{"source_product_id": "ML-1070138294", "name": "Bộ trà Mẫu Đơn Trắng", "description": "Hoa Mẫu Đơn có vẻ đẹp vừa quyến rũ, sang trọng vừa tao nhã, nhẹ nhàng, cánh hoa mỏng manh và nhiều lớp. Các nghệ nhân Minh Long đã đưa những đường cong uốn lượn mềm mại của hoa Mẫu Đơn vào trong chi tiết thiết kế ở vành ly và tay cầm của bộ trà Mẫu Đơn.", "product_url": "https://minhlong.com/products/bo-tra-mau-don-trang", "category": "Mẫu Đơn", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138207", "name": "Bộ trà Camellia Hoa Đào", "description": "Đào thắm tươi của miền Bắc là loài hoa mang lại sự an lành, hạnh phúc mỗi dịp Tết đến. Những búp hoa Đào khỏe khoắn, e ấp rồi bung rộ thắm tươi tượng trưng cho sự sinh sôi, nảy nở như gợi nhắc về ý nghĩa sum họp đoàn viên bên gia đình.", "product_url": "https://minhlong.com/products/bo-tra-camellia-hoa-dao", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138143", "name": "Bộ trà Camellia Hoa Mai", "description": "Mai vàng rực rỡ của miền Nam là biểu tượng cho sự may mắn, thịnh vượng. Những cánh hoa Mai bung nở rực rỡ như gửi lời chúc một năm mới tài lộc, may mắn.", "product_url": "https://minhlong.com/products/bo-tra-camellia-hoa-mai", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138114", "name": "Bộ trà Camellia Cát Tường", "description": null, "product_url": "https://minhlong.com/products/bo-tra-camellia-cat-tuong", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138104", "name": "Bộ trà Camellia Hương Biển Kem", "description": "Những hình ảnh thân quen nghêu, sò, ốc, hến... được thể hiện thông qua nét vẽ giản dị nhưng nổi bật trên nền sứ trắng kem trang nhã, mang lại cho chúng ta một làn gió biển tươi mát trong những buổi trà chiều tươi xanh, nhẹ nhàng.", "product_url": "https://minhlong.com/products/bo-tra-camellia-huong-bien-kem", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138075", "name": "Bộ trà Camellia Diệp Lục", "description": null, "product_url": "https://minhlong.com/products/bo-tra-camellia-diep-luc", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138052", "name": "Bộ trà Camellia Lộc Lạc", "description": "Hình ảnh Lộc Lạc tái hiện sống động nền văn hóa hưng thịnh xưa vừa mang nét đẹp truyền thống vừa có phong cách hiện đại. Sự phối màu hài hòa với sắc xanh cobalt trang nhã tạo nên sự sang trọng, tinh tế cho bộ trà Camellia Lộc Lạc.", "product_url": "https://minhlong.com/products/bo-tra-camellia-loc-lac", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070138015", "name": "Bộ trà Camellia Chỉ Vàng", "description": "Camellia là một loại hoa trà Nhật Bản, cánh hoa nhiều lớp, đài hoa cứng cáp là nguồn cảm hứng để các nghệ nhân Minh Long sáng tạo nên bộ trà Camellia với những đường nét hài hòa vừa vững chắc vừa mềm mại. Sự sang trọng được tô điểm bởi đường viền vàng trên mỗi sản phẩm, giúp cho bộ trà thêm phần đẳng cấp.", "product_url": "https://minhlong.com/products/bo-tra-camellia-chi-vang", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137919", "name": "Bộ trà Camellia Chỉ Xanh Dương", "description": "Camellia là một loại hoa trà Nhật Bản, cánh hoa nhiều lớp, đài hoa cứng cáp là nguồn cảm hứng để các nghệ nhân Minh Long sáng tạo nên bộ trà Camellia với những đường nét hài hòa vừa vững chắc vừa mềm mại. Được trang trí nhẹ nhàng bằng đường chỉ xanh dương cho nét mềm mại, thanh thoát, giúp đem đến không gian thoáng đãng và dịu nhẹ cho phòng khách của gia đình bạn.", "product_url": "https://minhlong.com/products/bo-tra-camellia-chi-xanh-duong", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137889", "name": "Bộ trà Camellia Trắng", "description": null, "product_url": "https://minhlong.com/products/bo-tra-camellia-trang", "category": "Camellia", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137848", "name": "Bộ trà Daisy Cỏ Tím", "description": "Daisy có màu men sáng bóng, láng mịn, tạo hình thon nhẹ phần đáy bình và vững chãi phần nắp bình tạo nên sự thanh thoát, yêu kiều. Một nhành cỏ tím mềm mại và ngọt ngào trên nền sứ trắng tinh đem đến cảm giác yêu chiều quyến rũ, liên tưởng đến những buổi chiều trên những cánh đồng cỏ tím mênh mông, gợi nhớ đến những giây phút thưởng trà an nhiên, ấm áp bên những người thân yêu.", "product_url": "https://minhlong.com/products/bo-tra-daisy-co-tim", "category": "Daisy", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137824", "name": "Bộ trà Daisy Trắng", "description": "Daisy là hoa cúc trắng với nét tinh khôi, mỏng manh và thuần khiết; các nghệ nhân gốm sứ Minh Long đã liên tưởng từ những đường nét của hoa cúc vào kiểu dáng thiết kế của bộ trà Daisy. Daisy có màu men sáng bóng, láng mịn, tạo hình thon nhẹ phần đáy bình và vững chãi phần nắp bình tạo nên sự thanh thoát, yêu kiều.", "product_url": "https://minhlong.com/products/bo-tra-daisy-trang", "category": "Daisy", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137641", "name": "Bộ trà Jasmine Tứ Quý", "description": "Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà. Hình ảnh của Mai - Trúc - Cúc - Tùng trên mỗi sản phẩm của bộ trà Jasmine nhắc nhở mọi người về hình ảnh 4 mùa trong năm, thời gian đều đặn trôi qua nhưng khoảnh khắc gia đình sum vầy bên nhau thưởng trà sẽ được lưu nhớ mãi.", "product_url": "https://minhlong.com/products/bo-tra-jasmine-tu-quy", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137609", "name": "Bộ trà Jasmine Phước Lộc Thọ", "description": "Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà. Phước - Lộc - Thọ là biểu tượng văn hóa in sâu trong tiềm thức của người Á Đông cầu mong điều tốt đẹp trong cuộc sống “may mắn, thịnh vượng, sức khỏe trường thọ”. Khắc họa sống động những hình ảnh này lên từng bình trà, tách trà Minh Long truyền tải thông điệp ý nghĩa, lời chúc an khang, thịnh vượng, tài lộc tới mọi người, mọi nhà.", "product_url": "https://minhlong.com/products/bo-tra-jasmine-phuoc-loc-tho", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070137573", "name": "Bộ trà Jasmine Vinh Quy Nhạt", "description": "Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà. Vinh Quy Nhạt là các hình ảnh về vinh quy bái tổ của trạng nguyên cưỡi ngựa với lọng che,cờ quạt, cờ biển... Mỗi hình ảnh đều được các nghệ nhân gốm sứ tài hoa khắc họa tinh tế và rõ nét nhằm gửi gắm thông điệp “khi thành công hãy nhớ về nguồn cội và biết ơn đấng sinh thành”.", "product_url": "https://minhlong.com/products/bo-tra-jasmine-vinh-quy-nhat", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070109980", "name": "Bộ trà Jasmine Chim Lạc", "description": "Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà. Chim Lạc là biểu tượng của phồn thịnh, bình an và may mắn. Chúng tôi đã khéo léo kết hợp giá trị văn hóa vào từng sản phẩm trong bộ trà Jasmine để lưu giữ và truyền bá nét văn hóa truyền thống dân tộc Việt Nam đến từng gia đình.", "product_url": "https://minhlong.com/products/bo-tra-jasmine-chim-lac", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1070109526", "name": "Bộ trà Jasmine Chỉ Xanh Lá", "description": "Lấy cảm hứng từ hoa nhài thuần khiết với hương thơm ngào ngạt, vẻ đẹp thanh tao được nhiều người yêu thích, chúng tôi đã chế tác nên bộ trà Jasmine với những đường nét uốn lượn mềm mại. Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà. Việc nhấn nhá với đường viền chỉ màu xanh lá đậm giúp cho sản phẩm thêm phần tinh tế và nhẹ nhàng.", "product_url": "https://minhlong.com/products/bo-tra-jasmine-chi-xanh-la", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_631739498", "name": "Dĩa sâu lòng - Timeless - Vườn Nhà", "description": "Lấy ý tưởng từ những hình ảnh của vườn quê thân thuộc, Vườn nhà tái hiện sống động bức tranh khung cảnh khu vườn quê vào mùa đơm hoa, kết trái với vẻ đẹp thân thuộc, mộc mạc và thanh bình. Vườn Nhà tạo điểm nhấn với hình ảnh những quả bí ngô to tròn, những bông hoa đang bung nở được phác họa một cách chân thực, tinh tế.", "product_url": "https://minhlong.com/products/dia-sau-long-timeless-vuon-nha", "category": "Timeless", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 82080, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_551463498", "name": "Tô (KL) - Timeless - Vườn Nhà", "description": "Lấy ý tưởng từ những hình ảnh của vườn quê thân thuộc, Vườn nhà tái hiện sống động bức tranh khung cảnh khu vườn quê vào mùa đơm hoa, kết trái với vẻ đẹp thân thuộc, mộc mạc và thanh bình. Vườn Nhà tạo điểm nhấn với hình ảnh những quả bí ngô to tròn, những bông hoa đang bung nở được phác họa một cách chân thực, tinh tế.", "product_url": "https://minhlong.com/products/to-kl-timeless-vuon-nha", "category": "Timeless", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 101520, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_591064000", "name": "Chén cơm - Timeless - Trắng", "description": "Timeless - bộ sản phẩm có thiết kế đơn giản nhưng đường nét sắc sảo, là lựa chọn thích hợp trong việc bài trí món ăn độc đáo, lạ mắt phù hợp với nhiều không gian và phong cách thưởng thức ẩm thực khác nhau. Sản phẩm được nung ở nhiệt độ cao theo tiêu chuẩn chất lượng của Đức – 1380oC và công nghệ nano giúp đạt được nước men đẹp nhất và độ cứng cao, an toàn với tần suất sử dụng thường xuyên như nhà hàng và dễ dàng vệ sinh, bảo quản.", "product_url": "https://minhlong.com/products/chen-com-timeless-trang", "category": "Timeless", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 33480, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "ML-1069937511", "name": "Bộ trà Jasmine Trắng", "description": "Lấy cảm hứng từ hoa nhài thuần khiết với hương thơm ngào ngạt, vẻ đẹp thanh tao được nhiều người yêu thích, chúng tôi đã chế tác nên bộ trà Jasmine với những đường nét uốn lượn mềm mại. Bộ trà Jasmine có kiểu dáng thanh lịch, chất liệu men sứ sáng bóng và láng mịn được nung ở nhiệt độ cao, giúp lưu giữ vị ngon của tách trà nóng và đem đến những giây phút thư thái, an nhiên khi thưởng trà.", "product_url": "https://minhlong.com/products/jasmine-trang", "category": "Jasmine", "material": "Sứ cao cấp", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_631739517", "name": "Dĩa sâu lòn