ice_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070174505", "name": "Bộ đồ ăn Hoàng Cung Lạc Hồng", "description": "Hoàng Cung là dãy sản phẩm cao cấp của Minh Long, mang phong cách cung đình, vương tộc nhưng vẫn đậm đà hình ảnh văn hóa dân gian Việt Nam. Sự sáng tạo nghệ thuật thể hiện ở từng nét vẽ có tính thẩm mỹ riêng tạo nên phần hồn, chiều sâu văn hóa của từng sản phẩm. Hoàng Cung Lạc Hồng với họa tiết vương giả được các nghệ nhân gốm sứ Minh Long trang trí bằng màu xanh cổ xưa và khắc họa hình đầu rồng đuôi phụng đặc trưng riêng của Minh Long", "product_url": "https://minhlong.com/products/bo-do-an-hoang-cung-lac-hong", "category": "Hoàng Cung", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070174296", "name": "Bộ đồ ăn Đài Các Trang Trí Bạch Kim", "description": "Gốm sứ được sử dụng trong các vương gia, quý tộc ngày xưa đòi hỏi những yêu cầu khắt khe về những đường nét sắc sảo, sang trọng và kiêu sa. Bộ sản phẩm Đài Các được các nghệ nhân của Minh Long truyền tải hết sự kiêu sa, quyền quý của quý tộc Châu Âu thông qua những hoa văn, đường chỉ, nét vẽ tinh tế đến mọi chi tiết, nổi bật chúng ta dễ thấy nhất là ở vành miệng hay tay cầm. Trang trí bạch kim tạo điểm nhấn một cách khéo léo ở những điểm nổi bật như vành, tay cầm. Hoa văn được tô điểm thêm đường viền bạch kim óng ánh làm toát nét sang trọng và đẳng cấp.", "product_url": "https://minhlong.com/products/bo-do-an-dai-cac-trang-tri-bach-kim", "category": "Khác", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070174172", "name": "Bộ đồ ăn Đài Các Chỉ Bạch Kim", "description": "Gốm sứ được sử dụng trong các vương gia, quý tộc ngày xưa đòi hỏi những yêu cầu khắt khe về những đường nét sắc sảo, sang trọng và kiêu sa. Bộ sản phẩm Đài Các được các nghệ nhân của Minh Long truyền tải hết sự kiêu sa, quyền quý của quý tộc Châu Âu thông qua những hoa văn, đường chỉ, nét vẽ tinh tế đến mọi chi tiết, nổi bật chúng ta dễ thấy nhất là ở vành miệng hay tay cầm. Bộ sản phẩm Đài Các chỉ bạch kim được viền bằng màu chỉ bạch kim đem đến sự sang trọng, quý phái cho không gian gia đình bạn.", "product_url": "https://minhlong.com/products/bo-do-an-dai-cac-chi-bach-kim", "category": "Đài Các", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070174077", "name": "Bộ đồ ăn Đài Các Chỉ Vàng", "description": "Gốm sứ được sử dụng trong các vương gia, quý tộc ngày xưa đòi hỏi những yêu cầu khắt khe về những đường nét sắc sảo, sang trọng và kiêu sa. Bộ sản phẩm Đài Các được các nghệ nhân của Minh Long truyền tải hết sự kiêu sa, quyền quý của quý tộc Châu Âu thông qua những hoa văn, đường chỉ, nét vẽ tinh tế đến mọi chi tiết, nổi bật chúng ta dễ thấy nhất là ở vành miệng hay tay cầm.", "product_url": "https://minhlong.com/products/bo-do-an-dai-cac-chi-vang", "category": "Đài Các", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070172506", "name": "Bộ đồ ăn Gastroline Kim Ngọc", "description": "Bộ sản phẩm Gastroline Kim Ngọc toát lên vẻ đẹp hiện đại và cuốn hút trong từng đường nét, tạo nên bức tranh sống động cho không gian ẩm thực. Với gam màu hiện đại, kiểu dáng thanh thoát phù hợp nhiều phong cách ẩm thực, Gastroline Kim Ngọc là nguồn cảm hứng bất tận cho đầu bếp thỏa thức sáng tạo và biến tấu món ăn thành một tác phẩm nghệ thuật. Đặc biệt, Gastroline là một trong những dòng sản phẩm trứ danh của Minh Long cùng nhà thiết kế Hans Wilhelm Seitz (nhà thiết kế đẳng cấp của Đức) từng được vinh danh là thiết kế có “ý tưởng thiết kế sản phẩm xuất sắc” tại giải Red Dot Design Award 2019 - Cuộc thi thiết kế quy mô và uy tín nhất toàn cầu.", "product_url": "https://minhlong.com/products/bo-do-an-gastroline-kim-ngoc", "category": "Gastroline", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070172422", "name": "Bộ đồ ăn Gastroline Đồng Tâm Xanh Dương", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Gastroline có thiết kế và kỹ thuật tạo hình sản phẩm đỉnh cao bởi độ khó thể hiện qua tạo hình ở những góc vuông cực kỳ sắc nét mà rất hiếm công ty gốm sứ nào trên thế giới có thể đạt được cho đến thời điểm hiện tại. Hoa văn Đồng Tâm xanh dương với những họa tiết được thiết kế tinh xảo mang tính đối xứng và đồng tâm tạo nên sự mới lạ, khác biệt và ấn tượng. Sự phối màu hài hòa giữa xanh dương và chỉ vàng làm nổi bật trên nền sứ trắng; mang đến cho gia đình bạn phong cách hiện đại, tân tiến với nhịp sống sôi động của thành thị.", "product_url": "https://minhlong.com/products/bo-do-an-gastroline-dong-tam-xanh-duong", "category": "Gastroline", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1070172395", "name": "Bộ đồ ăn Gastroline Đồng Tâm Xanh Lá", "description": "Gastroline là dòng sản phẩm đạt giải thưởng “Ý tưởng thiết kế sản phẩm xuất sắc nhất” tại cuộc thi thiết kế nổi tiếng thế giới Red Dot Design Award. Gastroline có thiết kế và kỹ thuật tạo hình sản phẩm đỉnh cao bởi độ khó thể hiện qua tạo hình ở những góc vuông cực kỳ sắc nét mà rất hiếm công ty gốm sứ nào trên thế giới có thể đạt được cho đến thời điểm hiện tại. Hoa văn Đồng Tâm xanh lá với những họa tiết được thiết kế tinh xảo mang tính đối xứng 