rigin_region": "Bình Dương", "price_vnd": 48600000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_694068555", "name": "Bình hoa Thái Hoà 40 cm + nắp - Bình Hoa - Hội Tựu", "description": "Không chỉ gợi nhắc đến sự sum vầy, Hội Tựu còn là biểu tượng của đất nước gấm hoa – nơi núi sông, văn hóa và con người cùng hòa quyện. Trên dáng vẻ thanh nhã và đường nét tinh xảo, chiếc bình trở thành nơi hội tụ hương sắc đất trời, để mỗi bông hoa khoe sắc cũng là lời chúc về một năm mới tròn đầy, thịnh vượng và bền lâu cùng cội nguồn dân tộc.", "product_url": "https://minhlong.com/products/binh-hoa-thai-hoa-nap-binh-hoa-hoi-tuu", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 36720000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_694020345V", "name": "Bình hoa Lộc Phát 40 cm - Bình Hoa - Sen vàng nền vàng", "description": null, "product_url": "https://minhlong.com/products/binh-hoa-loc-phat-40-cm-binh-hoa-sen-vang-nen-vang", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 12808800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_692821345X", "name": "Bình hoa Lộc Phát 28 cm - Bình hoa - Sen vàng nền xanh ngọc", "description": null, "product_url": "https://minhlong.com/products/binh-hoa-loc-phat-28-cm-binh-hoa-sen-vang-nen-xanh-ngoc", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 4039200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_692821345V", "name": "Bình hoa Lộc Phát 28 cm - Bình Hoa - Sen vàng nền vàng", "description": null, "product_url": "https://minhlong.com/products/binh-hoa-loc-phat-28-cm-binh-hoa-sen-vang-nen-vang", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 4039200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_115054345", "name": "Bình hoa 50 cm - Bình Hoa - Sen Vàng", "description": null, "product_url": "https://minhlong.com/products/binh-hoa-50-cm-binh-hoa-sen-vang", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 32788800, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_114554345", "name": "Bình hoa 45 cm - Bình Hoa - Sen Vàng", "description": "Khoác lên vẻ truyền thống, nền nã của loài hoa Á Đông nhưng lại không kém phần tinh tế hiện đại, những cánh sen bung tròn, phúc hậu ôm lấy nhụy đã được tái hiện sống động bằng màu xanh cobalt đặc trưng của cung đình Huế. Bức tranh chân thực và sống động về lá, cỏ và hoa sen như đưa người ngắm về với một làng quê Việt Nam vốn yên bình, trù phú... &nbsp;Nghệ nhân cũng khéo léo tạo nét vương giả bằng những chi tiết vẽ vàng 24k uyển chuyển trên từng cánh hoa, vành, tay cầm và nắp tạo nên sắc màu lấp lánh dưới sự phản chiếu của ánh sáng. Bộ sản phẩm thích hợp cho những buổi sum họp thân tình trong không gian yên bình, thư giãn vừa gần gũi vừa sang trọng.", "product_url": "https://minhlong.com/products/binh-hoa-45-cm-binh-hoa-sen-vang", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 17301600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_R024124027", "name": "Bình hoa 41 cm - Hoa sen - Bình Hoa - Trang trí", "description": "Bình hoa được các Nghệ nhân Minh Long vẽ tay hoàn toàn, các hoạ tiết được phác hoạ tỉ mỉ, khéo léo với màu sắc hài hoà.&nbsp; Như một tác phẩm nghệ thuật, bình hoa Minh Long luôn luôn được sáng tác kì công trong từng nét vẽ, để kể một câu chuyện đặc sắc về thiên nhiên, con người hoặc văn hoá.&nbsp; Ngoài việc sử dụng để tôn lên vẻ đẹp mĩ miều của các loài hoa, bình thủ công còn là một tác phẩm trang trí nâng tầm không gian sống của gia đình hoặc xứng đáng là vật phẩm quà tặng giá trị cao cho những dịp đặc biệt. Bình vẽ tay thủ công nên hình ảnh sản phẩm chỉ mang tính chất minh họa.", "product_url": "https://minhlong.com/products/binh-hoa-41-cm-hoa-sen-binh-hoa-trang-tri-1", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 25704000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_R024124025", "name": "Bình hoa 41 cm - Bình Hoa - Anh Túc - Trang trí", "description": "Bình hoa được các Nghệ nhân Minh Long vẽ tay hoàn toàn, các hoạ tiết được phác hoạ tỉ mỉ, khéo léo với màu sắc hài hoà.&nbsp; Như một tác phẩm nghệ thuật, bình hoa Minh Long luôn luôn được sáng tác kì công trong từng nét vẽ, để kể một câu chuyện đặc sắc về thiên nhiên, con người hoặc văn hoá.&nbsp; Ngoài việc sử dụng để tôn lên vẻ đẹp mĩ miều của các loài hoa, bình thủ công còn là một tác phẩm trang trí nâng tầm không gian sống của gia đình hoặc xứng đáng là vật phẩm quà tặng giá trị cao cho những dịp đặc biệt. Bình vẽ tay thủ công nên hình ảnh sản phẩm chỉ mang tính chất minh họa.", "product_url": "https://minhlong.com/products/binh-hoa-41-cm-binh-hoa-anh-tuc-trang-tri", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 24300000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_442384TBV", "name": "Tượng Bảo Mã 23.9 cm (Trang Trí Vàng) - Tượng - Trắng", "description": "Từ thuở xa xưa, Ngựa là biểu tượng của ý chí, sức mạnh, trí tuệ và lòng trung thành. Không chỉ đồng hành cùng các bậc quân vương, tráng sĩ xông pha trận mạc, Ngựa còn gắn bó với con người trên hành trình khai phá và mở mang bờ cõi. Ở loài vật này, hội tụ sức mạnh của thể lực, sự bền bỉ của ý chí cũng như vẻ đẹp khôi ngô tuấn tú. Bởi thế, trong sử thi nhân loại, duy chỉ Ngựa mới được gọi là “tuấn mã”.&nbsp; Khởi nguồn từ huyền thoại Hãn Huyết Bảo Mã, loài chiến mã từng cùng đế vương chinh phục bốn phương, Minh Long kiến tạo Bộ sưu tập Tượng Bảo Mã, tôn vinh tinh thần tự tại sau hành trình chinh phục, biểu trưng cho thành công viên mãn và khí chất uy nghi của người dẫn đầu. Tác phẩm không khắc họa chiến mã giữa sa trường, mà là Bảo Mã của thời bình, ung dung tự tại nhưng vẫn toát lên uy lực. Dáng ngựa oai phong và đỉnh đạc, bờm tung gió, từng thớ cơ căng tràn sức sống, là nhịp thở của tự do và tự tin. Đôi mắt sáng, điềm tĩnh như người từng trải qua thử thách mà vẫn giữ tâm thế vững vàng.&nbsp; Yên cương điểm xuyết hoa sen (Quốc hoa Việt Nam), tượng trưng cho vẻ đẹp thanh cao và cũng là nền tảng của mọi chiến thắng bền vững. Dưới vó ngựa, vòng tròn tựa dấu ấn thời gian, tượng trưng cho mỗi bước đi vững chãi đều mở ra hành trình mới. Đồng thời khép lại chu kỳ cũ, lưu giữ kỷ niệm hào hùng hay kinh nghiệm quý giá trong quá khứ, với sự thành công viên mãn.&nbsp; Bộ sưu tập Tượng Bảo Mã đa dạng màu sắc và kích cỡ, phù hợp cho nhiều không gian trưng bày sang trọng. Đồng thời là món quà biểu trưng cho sự thành đạt và may mắn.&nbsp; Bảo Mã không chỉ là tác phẩm nghệ thuật độc đáo, mà còn là biểu tượng của người thành công, an nhiên sau thử thách, tự tại giữa thịnh vượng. Bộ sưu tập gửi gắm lời chúc “Bính Ngọ Vinh Hoa”, mở đầu cho một năm mới phú quý và vinh hiển. &nbsp; Thông tin kỹ thuật: Chiều dài ~ 23.73 cm Chiều cao ~ 24.35&nbsp;cm Chiều rộng ~ 10.05 cm Cân nặng: ~ 1162gr (+/-10%) &nbsp;", "product_url": "https://minhlong.com/products/tuong-bao-ma-23-9-cm-tuong-trang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 6372000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_442384563", "name": "Tượng Bảo Mã 23.9 cm - Tượng - Lưu Ly Xanh", "description": "Từ thuở xa xưa, Ngựa là biểu tượng của ý chí, sức mạnh, trí tuệ và lòng trung thành. Ở loài vật này, hội tụ sức mạnh của thể lực, sự bền bỉ của ý chí cũng như vẻ đẹp khôi ngô tuấn tú. Bởi thế, trong sử thi nhân loại, duy chỉ Ngựa mới được gọi là “tuấn mã”.&nbsp; Từ nguồn cảm hứng ấy, Minh Long đã tái hiện hình tượng Ngựa qua những tác phẩm sứ mang dấu ấn riêng. Trong đó, Tượng Ngựa Lưu Ly Xanh là một chế tác đặc biệt, tôn vinh phong thái của người từng đi qua thành công, đạt đến sự tự tại và viên mãn.&nbsp; Men lưu ly xanh là dòng men cổ quý hiếm, từng xuất hiện trong kiến trúc cung đình từ thời Lý, Trần, Lê đến Nguyễn. Khi được bản địa hóa tại Việt Nam, sắc men trở nên trầm tĩnh và hài hòa hơn, mang theo tinh thần Á Đông thanh nhã và trở thành một phần của di sản gốm sứ.&nbsp; Thế nhưng, chính vẻ đẹp ấy lại đi kèm những thách thức lớn. Màu men phụ thuộc tuyệt đối vào nhiệt độ và môi trường nung; chỉ một sai lệch nhỏ cũng khiến sắc độ biến đổi. Bề mặt men phải đạt được độ trong sâu như thủy tinh, không bọt khí, không vân cháy, đồng thời tương thích hoàn hảo với xương gốm để tránh rạn nứt. Mỗi mẻ nung vì vậy giống như một cuộc “thử lửa”, nơi kỹ thuật, sự kiên nhẫn và cảm quan của nghệ nhân đều được đặt lên bàn cân.&nbsp; Song dưới bàn tay tài hoa của nghệ nhân và kỹ thuật hiện đại, lớp men ấy được đánh thức trọn vẹn, tạo chiều sâu trong trẻo và lấp lánh tựa đá quý. Sắc xanh trải dọc thân ngựa như sắc ngọc lưu ly ôm lấy dáng hình uyển chuyển. Một vẻ đẹp “như ngọc mà không phải ngọc”, giao hòa giữa đất và lửa, giữa cổ điển và hiện đại, phản chiếu tâm thế người đã đi qua thử thách và tỏa sáng từ nội tâm. Từ nền men ấy, họa tiết hoa sen (Quốc hoa Việt Nam) được điểm xuyết khéo léo nơi yên cương, tượng trưng cho vẻ đẹp thanh cao của tuấn mã. Dưới vó ngựa, vòng tròn tựa dấu ấn thời gian, tượng trưng cho mỗi bước đi vững chãi đều mở ra hành trình mới, khép lại chu kỳ cũ trong sự viên mãn.&nbsp; Không chỉ là một tác phẩm nghệ thuật, Tượng Ngựa Lưu Ly Xanh còn là biểu tượng của cát tường, thịnh vượng và vinh hoa. Sắc men quý hòa cùng tạo hình tuấn mã oai phong, chế tác là món quà ý nghĩa, lan tỏa nguồn năng lượng tích cực, nhắc nhớ thành công không chỉ ở đích đến, mà là phong thái tự tại sau chặng đường đã qua. Thông tin kỹ thuật: Chiều dài ~ 23.73 cm Chiều cao ~ 24.35 cm Chiều rộng ~ 10.05 cm Cân nặng ~ 1162 gr (+/-10%)", "product_url": "https://minhlong.com/products/tuong-bao-ma-23-9-cm-tuong-luu-ly-xanh", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 3888000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_441084TBV", "name": "Tượng Bảo Mã 10.5 cm (Trang Trí Vàng) - Tượng - Trắng", "description": "Từ thuở xa xưa, Ngựa là biểu tượng của ý chí, sức mạnh, trí tuệ và lòng trung thành. Không chỉ đồng hành cùng các bậc quân vương, tráng sĩ xông pha trận mạc, Ngựa còn gắn bó với con người trên hành trình khai phá và mở mang bờ cõi. Ở loài vật này, hội tụ sức mạnh của thể lực, sự bền bỉ của ý chí cũng như vẻ đẹp khôi ngô tuấn tú. Bởi thế, trong sử thi nhân loại, duy chỉ Ngựa mới được gọi là “tuấn mã”.&nbsp; Khởi nguồn từ huyền thoại Hãn Huyết Bảo Mã, loài chiến mã từng cùng đế vương chinh phục bốn phương, Minh Long kiến tạo Bộ sưu tập Tượng Bảo Mã, tôn vinh tinh thần tự tại sau hành trình chinh phục, biểu trưng cho thành công viên mãn và khí chất uy nghi của người dẫn đầu. Tác phẩm không khắc họa chiến mã giữa sa trường, mà là Bảo Mã của thời bình, ung dung tự tại nhưng vẫn toát lên uy lực. Dáng ngựa oai phong và đỉnh đạc, bờm tung gió, từng thớ cơ căng tràn sức sống, là nhịp thở của tự do và tự tin. Đôi mắt sáng, điềm tĩnh như người từng trải qua thử thách mà vẫn giữ tâm thế vững vàng.&nbsp; Yên cương điểm xuyết hoa sen (Quốc hoa Việt Nam), tượng trưng cho vẻ đẹp thanh cao và cũng là nền tảng của mọi chiến thắng bền vững. Dưới vó ngựa, vòng tròn tựa dấu ấn thời gian, tượng trưng cho mỗi bước đi vững chãi đều mở ra hành trình mới. Đồng thời khép lại chu kỳ cũ, lưu giữ kỷ niệm hào hùng hay kinh nghiệm quý giá trong quá khứ, với sự thành công viên mãn.&nbsp; Bộ sưu tập Tượng Bảo Mã đa dạng màu sắc và kích cỡ, phù hợp cho nhiều không gian trưng bày sang trọng. Đồng thời là món quà biểu trưng cho sự thành đạt và may mắn.&nbsp; Bảo Mã không chỉ là tác phẩm nghệ thuật độc đáo, mà còn là biểu tượng của người thành công, an nhiên sau thử thách, tự tại giữa thịnh vượng. Bộ sưu tập gửi gắm lời chúc “Bính Ngọ Vinh Hoa”, mở đầu cho một năm mới phú quý và vinh hiển.", "product_url": "https://minhlong.com/products/tuong-bao-ma-10-5cm-tuong-trang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 780840, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_11400905501", "name": "Bình hoa 41 cm - Bình Hoa - Hoa Hồng", "description": "Bình hoa được các Nghệ nhân Minh Long vẽ tay hoàn toàn, các hoạ tiết được phác hoạ tỉ mỉ, khéo léo với màu sắc hài hoà.&nbsp; Như một tác phẩm nghệ thuật, bình hoa Minh Long luôn luôn được sáng tác kì công trong từng nét vẽ, để kể một câu chuyện đặc sắc về thiên nhiên, con người hoặc văn hoá.&nbsp; Ngoài việc sử dụng để tôn lên vẻ đẹp mĩ miều của các loài hoa, bình thủ công còn là một tác phẩm trang trí nâng tầm không gian sống của gia đình hoặc xứng đáng là vật phẩm quà tặng giá trị cao cho những dịp đặc biệt. Bình vẽ tay thủ công nên hình ảnh sản phẩm chỉ mang tính chất minh họa.", "product_url": "https://minhlong.com/products/binh-hoa-41-cm-binh-hoa-hoa-hong", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 97200000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_1172950560", "name": "Bình Khổng Tước - Sứ Vẽ Tay - Trang Trí", "description": "Bình hoa được các Nghệ nhân Minh Long vẽ tay hoàn toàn, các hoạ tiết được phác hoạ tỉ mỉ, khéo léo với màu sắc hài hoà.&nbsp; Như một tác phẩm nghệ thu