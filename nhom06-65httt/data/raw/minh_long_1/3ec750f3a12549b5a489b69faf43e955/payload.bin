", "price_vnd": 723600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_042060074", "name": "Dĩa tròn 20 cm - Camellia - Tứ Linh", "description": null, "product_url": "https://minhlong.com/products/dia-tron-20-cm-camellia-tu-linh", "category": "Camellia", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 252720, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23482015000", "name": "[GT] Tô 20 cm - Camellia IFP  - Trắng Ngà", "description": null, "product_url": "https://minhlong.com/products/to-20-cm-camellia-ifp-trang-nga-1", "category": "Camellia IFP", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 71820, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23061821022", "name": "[GT] Thố 18 cm + nắp - Sen - Trang Trí", "description": null, "product_url": "https://minhlong.com/products/tho-18-cm-nap-sen-trang-tri", "category": "Sen", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 534600, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23472309014", "name": "[GT] Dĩa súp 23 cm - Jasmine IFP - Chỉ Vàng", "description": "Lưu ý: Không dùng sản phẩm trong máy rửa chén, lò vi sóng.", "product_url": "https://minhlong.com/products/dia-sup-23-cm-jasmine-ifp-chi-vang", "category": "Jasmine IFP", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 87210, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23042342043", "name": "[GT] Dĩa súp 23 cm - Tulip IFP - Chỉ Bạch Kim", "description": "Lưu ý: Không dùng sản phẩm trong máy rửa chén, lò vi sóng.", "product_url": "https://minhlong.com/products/dia-sup-23-cm-tulip-ifp-chi-bach-kim", "category": "Tulip IFP", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 55620, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_212471000", "name": "Khay mứt tròn 5 ngăn 24cm + nắp - Misc Assortment", "description": null, "product_url": "https://minhlong.com/products/khay-mut-tron-5-ngan-24cm-nap-misc-assortment", "category": "Misc Assortment", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 745200, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_442384BMN", "name": "Tượng Bảo Mã 23.9 cm - Tượng - Men Ngọc (bóng)", "description": "Từ thuở xa xưa, Ngựa là biểu tượng của ý chí, sức mạnh, trí tuệ và lòng trung thành. Không chỉ đồng hành cùng các bậc quân vương, tráng sĩ xông pha trận mạc, Ngựa còn gắn bó với con người trên hành trình khai phá và mở mang bờ cõi. Ở loài vật này, hội tụ sức mạnh của thể lực, sự bền bỉ của ý chí cùng như vẻ đẹp khỏe khoắn, tuấn tú. Bởi thế, trong sử thi nhân loại, duy chỉ Ngựa mới được gọi là “tuấn mã”. Khởi nguồn từ tinh thần ấy, Minh Long kiến tạo Tượng Bảo Ngọc Thanh Minh trong vóc dáng Hoàng Gia khoan thai, thần thái điềm tĩnh, toát lên khí chất ung dung của những giá trị tốt đẹp đã được tôi luyện, định hình và khẳng định theo năm tháng. Tác phẩm nổi bật với men xanh celadon bóng, trong, sâu và mát dịu như ngọc. Sắc men gợi cảm giác minh triết, chuẩn mực và nhất quán, cũng là vẻ đẹp của nền tảng tri thức vững vàng cùng đạo lý được gìn giữ bền bỉ. Tạo hình ấn tượng với ba chân trụ vững, một chân nhẹ nhàng vươn về phía trước, biểu trưng cho trạng thái cân bằng giữa ổn định và tiến bước. Thân hình cân đối, ánh mắt tinh anh nhưng trầm tĩnh, toát lên nội lực của sự tự chủ và khả năng suy xét thấu đáo. Bờm ngựa được tạo hình từng lọn mềm mại mà khỏe khoắn như tóc người nghệ nhân, anh hùng, gợi nét phong trần và khí chất của tuấn mã hoàng gia. Yên cương tinh giản mà sang trọng, điểm xuyết họa tiết hoa sen (Quốc hoa Việt Nam), nhắc nhớ về cội nguồn dân tộc, trí tuệ thanh cao và liêm chính, để mỗi lựa chọn đều hướng đến lợi ích chung và lâu dài. Lấy văn hóa truyền thống làm điểm tựa cho tinh thần sáng tạo đương đại, Tượng Bảo Ngọc Thanh Minh hiện diện như một điểm nhấn trang nhã trong không gian bày trí. Từ đó lan tỏa sự tự tin và sức mạnh nội tại của người sở hữu, gắn liền với ước vọng về sự ổn định, hài hòa và tinh thần trách nhiệm đối với cộng đồng, xã hội. &nbsp; Thông tin kỹ thuật: Chiều dài ~ 23.73 cm Chiều cao ~ 24.35&nbsp;cm Chiều rộng ~ 10.05 cm Cân nặng: ~ 1162gr (+/-10%)", "product_url": "https://minhlong.com/products/tuong-bao-ma-23-9-cm-tuong-men-ngoc-bong", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 6372000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_042365021", "name": "Dĩa sâu lòng 23 cm\t- Camellia - Chỉ Xanh Dương", "description": null, "product_url": "https://minhlong.com/products/dia-sau-long-23-cm-chi-xanh-duong", "category": "Camellia", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 159840, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_11605400401", "name": "Bình hoa 60 cm - Hoa tây cobalt", "description": null, "product_url": "https://minhlong.com/products/binh-hoa-60-cm-hoa-tay-cobalt", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 99360000, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A001_GT23042297176", "name": "[GT] Dĩa tròn 22 cm - Mẫu Đơn - Thanh Trúc", "description": null, "product_url": "https://minhlong.com/products/dia-tron-22-cm-mau-don-thanh-truc", "category": "Mẫu Đơn", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 83592, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "A00