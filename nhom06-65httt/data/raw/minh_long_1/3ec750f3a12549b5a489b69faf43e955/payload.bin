_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076317063", "name": "Cặp Kỳ Lân - Màu Đỏ", "description": null, "product_url": "https://minhlong.com/products/cap-ky-lan-mau-do", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076317047", "name": "Cặp Kỳ Lân - Men Xanh cổ (KV)", "description": null, "product_url": "https://minhlong.com/products/cap-ky-lan-men-xanh-co-kv", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076295022", "name": "Đàn Gà", "description": "&nbsp; Một khoảng sân quê mở ra với gà trống, gà mái và đàn gà con quây quần bên cỏ non - bình yên đến mức tưởng như nghe được tiếng gọi nhau trong buổi sớm. Bằng những nét vẽ tinh tế, người nghệ nhân đưa vào từng chiếc mào, lớp lông và dáng điệu riêng của mỗi chú gà, để câu chuyện về một mái nhà sum vầy được kể bằng sắc màu, gần gũi mà vẫn đầy sức sống. &nbsp;", "product_url": "https://minhlong.com/products/dan-ga", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076295016", "name": "Đôi Bạn", "description": "Hai chú vẹt tìm thấy nhau giữa một vòm lá xanh, nơi sắc đỏ, cam, vàng và xanh lam nối tiếp nhau như một bản hòa sắc của rừng nhiệt đới. Từng lớp lông, ánh mắt và dáng chim được chăm chút qua nét vẽ thủ công, khiến đôi bạn không chỉ hiện diện trên mặt gốm mà như đang cùng nhau giữ lại một khoảnh khắc tự do, sinh động giữa thiên nhiên.", "product_url": "https://minhlong.com/products/doi-ban", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076295007", "name": "Duyên Quê", "description": "Có những vẻ đẹp chẳng cần phô bày, chỉ cần một mái ngói, con đường nhỏ và dáng người qua phố cũng đủ gợi về cả một miền ký ức. Trên thân bình, người nghệ nhân chắt lọc từng nếp nhà, hàng quán, bóng cây thành một bức tranh phố xưa; để càng ngắm, ta càng cảm nhận được cái duyên mộc mạc của một đời sống Việt đã đi qua nhưng chưa bao giờ xa khỏi ký ức", "product_url": "https://minhlong.com/products/duyen-que", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294999", "name": "Sắc Màu", "description": "Giữa nền son thẫm, những đóa sen vươn mình khoe sắc, cánh hoa chuyển màu mềm mại như đón lấy ánh sáng. Từ sắc đỏ, xanh đến những đường viền vàng thanh thoát, tất cả được người nghệ nhân đặt xuống bằng những nét cọ giàu sức sống, để một loài hoa vốn mang vẻ đẹp thanh khiết nay hiện lên đầy rực rỡ và kiêu sa.", "product_url": "https://minhlong.com/products/sac-mau", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294995", "name": "Sen nền Vàng", "description": "Nền vàng dịu phủ lên dáng bình như một lớp nắng nhẹ, làm những đóa sen xanh càng trở nên nổi bật. Từ cánh hoa, gương sen đến những chiếc lá đang độ chuyển mình, tất cả được khắc họa bằng những nét vẽ mềm và có chiều sâu - để vẻ đẹp thanh tao của sen gặp gỡ sắc vàng ấm áp, tạo nên một tác phẩm mang vẻ đằm thắm, quý phái và đầy sức sống.", "product_url": "https://minhlong.com/products/sen-nen-vang", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294991", "name": "Dây Lá", "description": "&nbsp; Những nhành lá vươn mình theo đường cong mềm mại, nối tiếp bằng những cụm hoa và quả nhỏ với sắc đỏ, vàng, xanh đan xen. Không cầu kỳ bởi một chủ thể duy nhất, vẻ đẹp của Dây Lá nằm ở nhịp điệu hài hòa của toàn bộ bố cục - nơi bàn tay người nghệ nhân biến những mảng màu tưởng chừng giản đơn thành một khu vườn đang chuyển mình trên nền sứ. &nbsp;", "product_url": "https://minhlong.com/products/day-la", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294981", "name": "Sen nền Xanh", "description": "Trên nền sứ xanh thanh nhã, những đóa sen lam lần lượt hé nở, xen giữa lá sen, đài sen và những cánh chuồn chuồn mong manh. Sự đối lập giữa sắc xanh sâu lắng và những đường nét trắng trong làm nổi bật vẻ thanh khiết của sen, cho thấy sự tinh tế của người nghệ nhân trong từng nét cọ.", "product_url": "https://minhlong.com/products/sen-nen-xanh", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294972", "name": "Hạnh phúc đính hoa - Chim cảnh", "description": "&nbsp; Một đôi chim nhỏ tìm về giữa những nhành hoa đang độ khoe sắc, tạo nên khung cảnh vừa sinh động vừa nên thơ. Từng dáng chim, cánh hoa và chuyển sắc được người nghệ nhân nâng niu qua nét vẽ thủ công, gửi vào tác phẩm một lời chúc về niềm vui, sự sum vầy và hạnh phúc viên mãn. &nbsp;", "product_url": "https://minhlong.com/products/hanh-phuc-dinh-hoa-chim-canh", "category": "Bình Hoa", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294937", "name": "Tượng Hạ", "description": null, "product_url": "https://minhlong.com/products/tuong-ha", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294907", "name": "Tượng Đông", "description": null, "product_url": "https://minhlong.com/products/tuong-dong", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294890", "name": "Tượng Cô gái", "description": null, "product_url": "https://minhlong.com/products/tuong-co-gai", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294878", "name": "Ném Đáo", "description": null, "product_url": "https://minhlong.com/products/nem-dao", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294869", "name": "Mèo Đại Cát Màu Hồng", "description": "Tượng mèo Đại Cát nổi bật với nét đẹp tinh tế, sắc sảo. Chế tác được tạo hình cân đối, với thế ngồi vững chãi, đôi tai vểnh, đôi mắt sáng tinh anh, miệng cười toát lên vẻ thông minh cơ trí, thần thái tự tin và bản lĩnh. Tác phẩm được trang trí với những gam màu được chọn lọc, đặc trưng cho yếu tố may mắn như đỏ, trắng, cam, hồng… và được điểm xuyết bằng vàng 24k đẳng cấp, sang trọng. &nbsp; Tượng mèo Đại Cát với vẻ đẹp độc đáo, đậm chất nghệ thuật mang nhiều thông điệp tốt lành đến chủ sở hữu, là lời chúc năm mới nhiều may mắn, thịnh vượng, an khang, vạn sự cát tường. &nbsp;", "product_url": "https://minhlong.com/products/meo-dai-cat-mau-hong", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294859", "name": "Mèo Đại Cát Màu Trắng", "description": "Tượng mèo Đại Cát nổi bật với nét đẹp tinh tế, sắc sảo. Chế tác được tạo hình cân đối, với thế ngồi vững chãi, đôi tai vểnh, đôi mắt sáng tinh anh, miệng cười toát lên vẻ thông minh cơ trí, thần thái tự tin và bản lĩnh. Tác phẩm được trang trí với những gam màu được chọn lọc, đặc trưng cho yếu tố may mắn như đỏ, trắng, cam, hồng… và được điểm xuyết bằng vàng 24k đẳng cấp, sang trọng. &nbsp; Tượng mèo Đại Cát với vẻ đẹp độc đáo, đậm chất nghệ thuật mang nhiều thông điệp tốt lành đến chủ sở hữu, là lời chúc năm mới nhiều may mắn, thịnh vượng, an khang, vạn sự cát tường. &nbsp;", "product_url": "https://minhlong.com/products/meo-dai-cat-mau-trang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294841", "name": "Mèo Ngũ Phúc", "description": "Tượng mèo với 5 ý nghĩa - những khát vọng lớn nhất trong cuộc đời mỗi người: phú (may mắn) - quý (tiền tài) - thọ (trường thọ) - ninh (bình an) - khang (sức khỏe). Tặng bức tượng ngày Tết như “Ngũ Phúc lâm môn” - đem những lời chúc tốt lành, trân trọng nhất đến mọi gia đình. Hình dáng và Màu sắc tượng Mèo Ngũ Phúc: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Hình dáng của tượng mèo mang tính cân đối. Mèo ngồi thế 4 chân chụm vào nhau tạo cảm giác vững chắc, con ngươi trong đôi mắt tròn xoe thể hiện sự tập trung, miệng cười mỉm mang đến sự vui vẻ. &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Hoạ tiết trên thân mèo dựa trên triết lý ngũ hành. Học thuyết ngũ hành là triết lý kinh điển về sự ra đời, cách tuần hoàn và phát triển của vũ trụ. Đó cũng chính là hình ảnh của sự “cân bằng”. &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Tổng thể bức tượng, dù nhìn ở mặt trái hay phải, từ sau đến trước đều thể hiện vòng tuần hoàn của tạo hóa. Mèo đứng trên phiến đá có trang trí những đồng tiền vàng (thổ sinh kim), phía lưng có những đồng tiền chảy theo dòng nước (kim sinh thủy), dòng nước này giúp cây cỏ sinh sôi (thủy sinh mộc), từ đó bùng lên ngọn lửa đỏ rực (mộc sinh hỏa), cuối cùng ngọn lửa vun đất thành núi cao (hỏa sinh thổ). Phía hai bên của chú mèo mô phỏng hình ảnh của vũ trụ với nhiều tinh tú, làm rõ hơn thông điệp của triết lý ngũ hành. Vì sao Mèo Ngũ Phúc đặc biệt? &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Men xanh celadon là tên gọi của dòng gốm cổ có niên đại hàng thế kỷ trước. Sắc xanh lục nhạt, nhìn trong như ngọc nên rất được người châu Á ưa chuộng. Dòng sứ này mô phỏng viên ngọc nên mọi tiêu chí đều dựa trên hình mẫu với hai yếu tố: màu sắc và độ trong. Nếu không đủ trong thì đường nét sẽ bị che, kém tinh tế. Đây cũng giống như một đỉnh cao mới trong ngành gốm sứ mà Minh Long cần phải chinh phục. Và sau 50 năm mơ ước và kiên trì theo đuổi, thất bại nhiều lần, Minh Long đã chạm đến được sự tinh hoa trong việc chế tác nên màu men xanh ngọc Celadon huyền thoại này. Bức tượng mang đến cảm giác như tạc từ khối ngọc thạch với hiệu ứng bóng mờ đẹp mắt, khi chạm vào có cảm giác mềm mịn như nhung &nbsp;", "product_url": "https://minhlong.com/products/meo-ngu-phuc", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294808", "name": "Trâu Vương Giả", "description": "Từ xa xưa, hình ảnh con trâu (Sửu) đã gắn bó thân thuộc với cuộc sống của người Á Đông nói chung, Việt Nam nói riêng và in sâu vào đời sống văn hóa tinh thần của nhiều dân tộc. Trâu tượng trưng cho sự an lành, no đủ với tính hiền lành, chăm chỉ và mưu trí. Trong văn hóa phương Tây, trâu tượng trưng cho sức mạnh và tài lộc. Đặc biệt, trong phong thủy, trâu được biết đến là linh vật trấn yểm hung tinh, mang đến phúc khí, thịnh vượng. &nbsp; Tượng trâu Vương Giả được tạo hình với thế tiến về phía trước, hào hùng đầy khí chất, có thân hình lực lưỡng, tràn đầy sức mạnh, chân vạm vỡ, mắt tinh anh, trong tư thế sẵn sàng tựa như chàng thanh niên đang thì hoàng kim, sung sức. &nbsp;", "product_url": "https://minhlong.com/products/trau-vuong-gia", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294788", "name": "Trâu Hạnh Phúc Dát Vàng", "description": "Từ xa xưa, hình ảnh con trâu (Sửu) đã gắn bó thân thuộc với cuộc sống của người Á Đông nói chung, Việt Nam nói riêng và in sâu vào đời sống văn hóa tinh thần của nhiều dân tộc. Trâu tượng trưng cho sự an lành, no đủ với tính hiền lành, chăm chỉ và mưu trí. Trong văn hóa phương Tây, trâu tượng trưng cho sức mạnh và tài lộc. Đặc biệt, trong phong thủy, trâu được biết đến là linh vật trấn yểm hung tinh, mang đến phúc khí, thịnh vượng. &nbsp; Tượng trâu Hạnh Phúc được tạo hình đầy đặn với thế ngồi vững chãi, mặt hân hoan, mắt tinh anh, miệng cười hồn nhiên, tươi tắn, biểu tượng cho sự an nhiên, tự tại, hoan hỷ. Hai tay linh vật nâng liễn đề bốn chữ “Lộc Phúc An Khang” bên cạnh nhiều đồng tiền vàng, với lời chúc năm mới nhiều may mắn, sum vầy, an lành và khỏe mạnh. &nbsp;", "product_url": "https://minhlong.com/products/trau-hanh-phuc-dat-vang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294720", "name": "Trâu Như Ý Màu Trắng", "description": "Từ xa xưa, hình ảnh con trâu (Sửu) đã gắn bó thân thuộc với cuộc sống của người Á Đông nói chung, Việt Nam nói riêng và in sâu vào đời sống văn hóa tinh thần của nhiều dân tộc. Trâu tượng trưng cho sự an lành, no đủ với tính hiền lành, chăm chỉ và mưu trí. Trong văn hóa phương Tây, trâu tượng trưng cho sức mạnh và tài lộc. Đặc biệt, trong phong thủy, trâu được biết đến là linh vật trấn yểm hung tinh, mang đến phúc khí, thịnh vượng. &nbsp; Nghệ thuật hóa sống động hình tượng trâu trong dân gian, tượng trâu Như Ý có tạo hình đầy đặn, trẻ trung, thần thái vui tươi và phấn khởi, miệng cười tươi tắn. Hai tay linh vật cầm hạt lúa vàng nâng niu, trân trọng với ý nghĩa mang đến sự sung túc, tài lộc, mùa vàng bội thu. &nbsp;", "product_url": "https://minhlong.com/products/trau-nhu-y-mau-trang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294686", "name": "Trâu Như Ý Màu Cam", "description": "Từ xa xưa, hình ảnh con trâu (Sửu) đã gắn bó thân thuộc với cuộc sống của người Á Đông nói chung, Việt Nam nói riêng và in sâu vào đời sống văn hóa tinh thần của nhiều dân tộc. Trâu tượng trưng cho sự an lành, no đủ với tính hiền lành, chăm chỉ và mưu trí. Trong văn hóa phương Tây, trâu tượng trưng cho sức mạnh và tài lộc. Đặc biệt, trong phong thủy, trâu được biết đến là linh vật trấn yểm hung tinh, mang đến phúc khí, thịnh vượng. &nbsp; Nghệ thuật hóa sống động hình tượng trâu trong dân gian, tượng trâu Như Ý có tạo hình đầy đặn, trẻ trung, thần thái vui tươi và phấn khởi, miệng cười tươi tắn. Hai tay linh vật cầm hạt lúa vàng nâng niu, trân trọng với ý nghĩa mang đến sự sung túc, tài lộc, mùa vàng bội thu. &nbsp;", "product_url": "https://minhlong.com/products/trau-nhu-y-mau-cam", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294658", "name": "Trâu Thịnh Vượng Màu Trắng", "description": "Từ xa xưa, hình ảnh con trâu (Sửu) đã gắn bó thân thuộc với cuộc sống của người Á Đông nói chung, Việt Nam nói riêng và in sâu vào đời sống văn hóa tinh thần của nhiều dân tộc. Trâu tượng trưng cho sự an lành, no đủ với tính hiền lành, chăm chỉ và mưu trí. Trong văn hóa phương Tây, trâu tượng trưng cho sức mạnh và tài lộc. Đặc biệt, trong phong thủy, trâu được biết đến là linh vật trấn yểm hung tinh, mang đến phúc khí, thịnh vượng. Tượng trâu Thịnh Vượng được tạo hình đầy đặn với thế đứng, đầu ngẩng cao, mặt hân hoan, mắt tinh anh, miệng cười tươi tắn, hạnh phúc. Chế tác được thiết kế đặc biệt với thế đứng vững chãi, sẵn sàng, thân hướng về phía trước, tượng trưng cho sự tiến tới, vượt qua mọi khó khăn. Chân linh vật mạnh mẽ vượt lên những phiến đá như vượt qua những thử thách, chân chạm vào đâu hóa vàng đến đó, ngụ ý đem đến tài lộc, phú quý. &nbsp;", "product_url": "https://minhlong.com/products/trau-thinh-vuong-mau-trang", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_time_days": null, "wholesale_available": null}, {"source_product_id": "1076294619", "name": "Chuột Quý Màu Cam", "description": "Chuột là linh vật đứng đầu 12 con giáp. Trong văn hóa dân gian, chuột gắn liền với sự nhanh nhẹn, thông minh, khôn khéo. Theo phong thủy, chuột mang đến sự sung túc, đủ đầy (nơi nào có chuột đến, nơi đó có của ăn của để dồi dào) . Tuyệt tác tượng chuột là chế tác đặc biệt của Minh Long, nghệ thuật hóa hình tượng chuột trong dân gian, có vẻ đẹp khỏe khoắn, tinh tế và sắc sảo. Tượng chuột Quý được tạo hình đầy đặn với thế đứng đầu ngẩng cao, mặt hân hoan, miệng cười tươi tắn, hạnh phúc, đôi mắt ngời sáng, lanh lợi. Hai tay linh vật cầm vàng, nâng niu trân trọng của quý, tượng trưng cho lộc trời ban. Chế tác được trang trí và cách điệu theo lối nghệ thuật, kết hợp cùng kỹ thuật vẽ màu dưới men với những gam màu được chọn lọc như đỏ, cam, trắng, xám và điểm xuyết bằng vàng 24K sang trọng. &nbsp;", "product_url": "https://minhlong.com/products/chuot-quy-mau-cam", "category": "Tượng", "material": "Gốm sứ", "origin_region": "Bình Dương", "price_vnd": 0, "currency": "VND", "moq": null, "lead_ti